# Default configuration for Host Slave OTA Simple Example

# Flash size configuration
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# Force enable ESP-Hosted component
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_HOSTED_ENABLED=y

# FreeRTOS configuration
CONFIG_FREERTOS_HZ=1000

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# P4 chip version select
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y

# Host Slave OTA config
CONFIG_OTA_METHOD_LITTLEFS=y

# Hosted slave config
# --- CORREGIDO para placa CrowPanel HW V1.1 / V1.2 (bus SDIO de 4 bits) ---
# Segun readme oficial de Elecrow: a partir de V1.1 el bus paso a 4 hilos
# y el orden de D0-D3 se invirtio de IO14,15,16,17 a IO17,16,15,14.
# V1.2 hereda esta misma configuracion (solo cambio el zocalo de modulo
# inalambrico opcional, no el bus fijo hacia el C6-MINI-1).
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_BUS_WIDTH=4
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=19
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=18
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=17
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=16
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=15
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=14
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=32

CONFIG_OTA_METHOD_LITTLEFS=y
CONFIG_OTA_METHOD_PARTITION=n
