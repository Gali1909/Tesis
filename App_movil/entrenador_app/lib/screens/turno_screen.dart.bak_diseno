import 'package:flutter/material.dart';

import '../services/database_helper.dart';
import '../services/juego_vivo_db.dart';
import '../services/turno_db.dart';
import '../services/corredores_db.dart';
import '../services/jugadas_corredor_db.dart';
import '../services/lanzador_rival_db.dart';
import '../services/marcador_db.dart';
import '../widgets/vivo_widgets.dart';

const Color _fondo = Color(0xFF14171C);
const Color _superficie = Color(0xFF1E232B);
const Color _cian = Color(0xFF0ABDCF);
const Color _rojo = Color(0xFFE63946);
const Color _textoSuave = Color(0xFF9AA4B2);

const Map<String, String> _etiquetas = {
  'sencillo': 'Sencillo',
  'doble': 'Doble',
  'triple': 'Triple',
  'home_run': 'Jonron',
  'out_roletazo': 'Out por roletazo',
  'out_elevado': 'Out por elevado',
  'out_linea': 'Out por linea',
  'error': 'Error',
  'boleto': 'Boleto',
  'ponche': 'Ponche',
  'golpeado': 'Golpeado',
};

const Map<String, String> _etiquetasLanzamiento = {
  'bola': 'Bola',
  'strike_cantado': 'Strike cantado',
  'strike_swing': 'Strike swing',
  'foul': 'Foul',
  'en_juego': 'En juego',
  'golpeado': 'Golpeado',
};

const List<String> _resultadosEnJuego = [
  'sencillo',
  'doble',
  'triple',
  'home_run',
  'out_roletazo',
  'out_elevado',
  'out_linea',
  'error',
];

class TurnoScreen extends StatefulWidget {
  final int juegoId;

  const TurnoScreen({super.key, required this.juegoId});

  @override
  State<TurnoScreen> createState() => _TurnoScreenState();
}

class _TurnoScreenState extends State<TurnoScreen> {
  Map<String, dynamic>? _juego;
  Map<String, dynamic>? _turno;
  Map<String, dynamic>? _siguiente;
  List<Map<String, dynamic>> _lanzamientos = [];
  List<Map<String, dynamic>> _entradas = [];
  List<Map<String, dynamic>> _tipos = [];
  int? _tipoId;
  bool _filtrado = false;
  Map<String, dynamic>? _lanzadorRival;
  Map<String, dynamic>? _pendiente;
  bool _dialogoCorredores = false;
  bool _ignorarPendiente = false;
  Map<String, dynamic>? _corr;
  Map<String, dynamic>? _ultimaJugada;
  bool _tipoCargado = false;
  bool _cargando = true;
  bool _ocupado = false;

  @override
  void initState() {
    super.initState();
    _cargar();
  }

  String _mensaje(Object e) => e.toString().replaceFirst('Bad state: ', '');

  void _aviso(String texto) {
    if (!mounted) return;
    ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(texto)));
  }

  Future<void> _cargar() async {
    final db = DatabaseHelper.instance;
    final juego = await db.obtenerJuegoVivo(widget.juegoId);
    if (!mounted) return;
    if (juego == null || juego['estado'] != 'en_juego') {
      Navigator.pop(context, true);
      return;
    }
    final turno = await db.obtenerTurnoAbierto(widget.juegoId);
    final lanzadorRival = await db.obtenerLanzadorRivalActual(widget.juegoId);
    final pendiente = await db.obtenerPendienteCorredores(widget.juegoId);
    final corr = await db.obtenerCorredoresActuales(widget.juegoId);
    final ultimaJugada = await db.obtenerUltimaJugadaDeshacible(widget.juegoId);
    final entradas = await db.obtenerEntradasJuego(widget.juegoId);
    Map<String, dynamic>? siguiente;
    var lanzamientos = <Map<String, dynamic>>[];
    if (turno == null) {
      try {
        siguiente = await db.siguienteBateadorTurno(widget.juegoId);
      } catch (e) {
        _aviso(_mensaje(e));
      }
    } else {
      lanzamientos = await db.obtenerLanzamientosTurno(turno['id'] as int);
    }
    if (turno != null) {
      final lanzadorId = turno['lanzador_id'] as int?;
      _tipos = await db.obtenerTiposPitcheoLanzador(lanzadorId);
      _filtrado = lanzadorId != null;
      if (_tipos.isEmpty && turno['propio'] == 1) {
        _tipos = await db.obtenerTiposPitcheo();
        _filtrado = false;
      }
    } else if (_tipos.isEmpty) {
      _tipos = await db.obtenerTiposPitcheo();
    }
    if (!_tipoCargado) {
      _tipoId = await db.ultimoTipoPitcheo(widget.juegoId);
      _tipoCargado = true;
    }
    if (_tipoId != null &&
        !_tipos.any((t) => t['tipo_lanzamiento_id'] == _tipoId)) {
      _tipoId = null;
    }
    if (!mounted) return;
    setState(() {
      _juego = juego;
      _lanzadorRival = lanzadorRival;
      _pendiente = pendiente;
      _corr = corr;
      _ultimaJugada = ultimaJugada;
      _entradas = entradas;
      _turno = turno;
      _siguiente = siguiente;
      _lanzamientos = lanzamientos;
      _cargando = false;
    });
    if (turno == null &&
        pendiente != null &&
        !_dialogoCorredores &&
        !_ignorarPendiente) {
      WidgetsBinding.instance.addPostFrameCallback((_) {
        if (mounted) _resolverPendiente();
      });
    }
  }

  Future<void> _ejecutar(Future<void> Function() accion) async {
    if (_ocupado) return;
    setState(() => _ocupado = true);
    try {
      await accion();
    } catch (e) {
      _aviso(_mensaje(e));
    }
    await _cargar();
    if (mounted) setState(() => _ocupado = false);
  }

  Future<void> _lanzar(String resultado, {String? resultadoTurno}) {
    return _ejecutar(() async {
      final cierre = await DatabaseHelper.instance.registrarLanzamientoTurno(
        widget.juegoId,
        _turno!['id'] as int,
        resultado,
        resultadoTurno: resultadoTurno,
        tipoId: _tipoId,
      );
      if (cierre != null) _aviso(_etiquetas[cierre] ?? cierre);
    });
  }

  Future<void> _enJuego([List<String>? claves]) async {
    final r = await showModalBottomSheet<String>(
      context: context,
      backgroundColor: _superficie,
      builder: (ctx) => SafeArea(
        child: Padding(
          padding: const EdgeInsets.all(16),
          child: Wrap(
            spacing: 10,
            runSpacing: 10,
            children: [
              for (final k in (claves ?? _resultadosEnJuego))
                ElevatedButton(
                  onPressed: () => Navigator.pop(ctx, k),
                  style: ElevatedButton.styleFrom(
                    backgroundColor: k.startsWith('out') ? _rojo : _cian,
                    foregroundColor: k.startsWith('out') ? Colors.white : Colors.black,
                    minimumSize: const Size(150, 52),
                  ),
                  child: Text(_etiquetas[k]!),
                ),
            ],
          ),
        ),
      ),
    );
    if (r == null) return;
    await _lanzar('en_juego', resultadoTurno: r);
  }

  Future<void> _iniciarTurno() async {
    final s = _siguiente!;
    if (s['propio'] == true && _lanzadorRival == null) {
      final ok = await _elegirLanzadorRival();
      if (!ok) return;
    }
    await _ejecutar(() async {
      await DatabaseHelper.instance.iniciarTurno(
        widget.juegoId,
        bateadorId: s['jugador_id'] as int,
        orden: s['orden'] as int,
      );
    });
  }

  Future<bool> _elegirLanzadorRival() async {
    final db = DatabaseHelper.instance;
    List<Map<String, dynamic>> existentes;
    List<Map<String, dynamic>> tipos;
    try {
      existentes = await db.obtenerLanzadoresRival(widget.juegoId);
      tipos = await db.obtenerTiposPitcheo();
    } catch (e) {
      _aviso(_mensaje(e));
      return false;
    }
    if (!mounted) return false;
    final r = await showDialog<Map<String, dynamic>>(
      context: context,
      builder: (_) => _DialogoLanzadorRival(existentes: existentes, tipos: tipos),
    );
    if (r == null) return false;
    try {
      if (r['id'] != null) {
        await db.fijarLanzadorRival(widget.juegoId, r['id'] as int);
      } else {
        await db.crearLanzadorRival(
          widget.juegoId,
          nombre: r['nombre'] as String,
          numero: r['numero'] as int?,
          mano: r['mano'] as String?,
          tipos: (r['tipos'] as List).cast<int>(),
        );
      }
    } catch (e) {
      _aviso(_mensaje(e));
      return false;
    }
    await _cargar();
    return true;
  }

  List<Widget> _infoLanzadorRival() {
    if (_siguiente?['propio'] != true) return const [];
    final l = _lanzadorRival;
    final etiqueta = l == null
        ? 'Lanzador rival sin identificar'
        : 'Lanza: ${l['numero'] != null ? '#${l['numero']} ' : ''}${l['nombre']}';
    return [
      const SizedBox(height: 6),
      Text(etiqueta, style: const TextStyle(color: _textoSuave, fontSize: 13)),
      TextButton(
        onPressed: _ocupado
            ? null
            : () {
                _elegirLanzadorRival();
              },
        child: Text(l == null ? 'ELEGIR LANZADOR RIVAL' : 'CAMBIAR LANZADOR RIVAL'),
      ),
    ];
  }

  Future<void> _agregarRival() async {
    final orden = _siguiente!['orden'] as int;
    final r = await showDialog<Map<String, dynamic>>(
      context: context,
      builder: (_) => _DialogoRival(orden: orden),
    );
    if (r == null) return;
    await _ejecutar(() async {
      final db = DatabaseHelper.instance;
      final id = await db.agregarBateadorRival(
        widget.juegoId,
        r['nombre'] as String,
        r['numero'] as int?,
      );
      await db.iniciarTurno(widget.juegoId, bateadorId: id, orden: orden);
    });
  }

  Future<void> _resolverPendiente() async {
    if (_dialogoCorredores || _pendiente == null) return;
    _dialogoCorredores = true;
    final p = _pendiente!;
    final r = await showDialog<List<Map<String, dynamic>>>(
      context: context,
      barrierDismissible: false,
      builder: (_) => _DialogoCorredores(pendiente: p),
    );
    _dialogoCorredores = false;
    if (r == null) {
      _ignorarPendiente = true;
      return;
    }
    _ignorarPendiente = false;
    if (!mounted) return;
    await _ejecutar(() async {
      await DatabaseHelper.instance.resolverCorredores(
        widget.juegoId,
        p['turno_id'] as int,
        r,
      );
    });
  }

  Future<void> _jugadaCorredores() async {
    final corr =
        ((_corr?['corredores'] as List?) ?? const []).cast<Map<String, dynamic>>();
    if (corr.isEmpty) return;
    final r = await showDialog<Map<String, dynamic>>(
      context: context,
      builder: (_) => _DialogoJugada(
        corredores: corr,
        outs: (_corr?['outs'] as int?) ?? 0,
      ),
    );
    if (r == null) return;
    await _ejecutar(() async {
      await DatabaseHelper.instance.registrarJugadaCorredores(
        widget.juegoId,
        r['tipo'] as String,
        (r['movs'] as List).cast<Map<String, dynamic>>(),
      );
    });
  }

  Future<void> _deshacerJugada() {
    return _ejecutar(() async {
      final ok = await DatabaseHelper.instance.deshacerJugadaCorredores(widget.juegoId);
      if (!ok) _aviso('No hay ninguna jugada que deshacer.');
    });
  }

  List<Widget> _botonesJugadas() {
    final hayCorredores = ((_corr?['corredores'] as List?) ?? const []).isNotEmpty;
    return [
      if (hayCorredores) ...[
        const SizedBox(height: 10),
        _boton('JUGADA DE CORREDORES', const Color(0xFF6B4FA0), _jugadaCorredores),
      ],
      if (_ultimaJugada != null) ...[
        const SizedBox(height: 10),
        _boton(
          'DESHACER JUGADA (${_etiquetasJugada[_ultimaJugada!['tipo']] ?? ''})',
          const Color(0xFF3A4252),
          _deshacerJugada,
        ),
      ],
    ];
  }

  Future<void> _deshacer() {
    return _ejecutar(() async {
      final ok = await DatabaseHelper.instance.deshacerLanzamientoTurno(widget.juegoId);
      if (!ok) _aviso('No hay ningun lanzamiento que deshacer.');
    });
  }

  int get _entrada => (_juego!['entrada_actual'] as int?) ?? 1;
  String get _mitad => (_juego!['mitad_actual'] as String?) ?? 'alta';
  int get _outs => (_juego!['outs_actuales'] as int?) ?? 0;
  bool get _local => ((_juego!['propio_local'] as int?) ?? 0) == 1;
  bool get _bateaPropio =>
      (_local && _mitad == 'baja') || (!_local && _mitad == 'alta');

  Widget _boton(String texto, Color color, VoidCallback onPressed) {
    return ElevatedButton(
      onPressed: _ocupado ? null : onPressed,
      style: ElevatedButton.styleFrom(
        backgroundColor: color,
        foregroundColor: Colors.white,
        disabledBackgroundColor: const Color(0xFF2A303A),
        minimumSize: const Size.fromHeight(60),
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(14)),
      ),
      child: Text(
        texto,
        textAlign: TextAlign.center,
        style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 13),
      ),
    );
  }

  Widget _tarjetaEstado() {
    final alta = _mitad == 'alta';
    return Container(
      padding: const EdgeInsets.all(16),
      decoration: BoxDecoration(
        color: _superficie,
        borderRadius: BorderRadius.circular(20),
        border: Border.all(color: const Color(0x550ABDCF)),
      ),
      child: Column(
        children: [
          Text(
            '${alta ? 'ALTA' : 'BAJA'} DE LA $_entrada  -  $_outs OUT${_outs == 1 ? '' : 'S'}',
            style: const TextStyle(
              color: Colors.white,
              fontSize: 16,
              fontWeight: FontWeight.bold,
              letterSpacing: 1,
            ),
          ),
          const SizedBox(height: 10),
          if (_turno != null) ..._contenidoTurno() else ...[..._contenidoSiguiente(), ..._infoLanzadorRival()],
        ],
      ),
    );
  }

  List<Widget> _contenidoTurno() {
    final t = _turno!;
    final numero = t['bateador_numero'];
    final nombre = (t['bateador_nombre'] as String?) ?? '?';
    final lanzador = t['lanzador_nombre'] as String?;
    return [
      const Text(
        'AL BATE',
        style: TextStyle(color: _textoSuave, fontSize: 12, letterSpacing: 2),
      ),
      Text(
        '#${t['orden']}  ${numero != null ? '#$numero ' : ''}$nombre',
        textAlign: TextAlign.center,
        style: const TextStyle(color: Colors.white, fontSize: 22, fontWeight: FontWeight.bold),
      ),
      if (lanzador != null)
        Text(
          'Lanza: $lanzador',
          style: const TextStyle(color: _textoSuave, fontSize: 13),
        ),
      const SizedBox(height: 10),
      Text(
        '${t['bolas']} - ${t['strikes']}',
        style: const TextStyle(color: _cian, fontSize: 52, fontWeight: FontWeight.bold),
      ),
      const Text(
        'BOLAS - STRIKES',
        style: TextStyle(color: _textoSuave, fontSize: 11, letterSpacing: 2),
      ),
    ];
  }

  List<Widget> _contenidoSiguiente() {
    final s = _siguiente;
    if (s == null) {
      return const [
        Text(
          'No se pudo calcular el siguiente bateador.',
          style: TextStyle(color: _textoSuave),
        ),
      ];
    }
    if (s['nuevo'] == true) {
      return [
        const Text(
          'TURNO DEL RIVAL',
          style: TextStyle(color: _textoSuave, fontSize: 12, letterSpacing: 2),
        ),
        Text(
          'Bateador ${s['orden']} del rival',
          style: const TextStyle(color: Colors.white, fontSize: 20, fontWeight: FontWeight.bold),
        ),
      ];
    }
    final numero = s['numero'];
    return [
      Text(
        s['propio'] == true ? 'SIGUIENTE EN TU LINEUP' : 'SIGUIENTE DEL RIVAL',
        style: const TextStyle(color: _textoSuave, fontSize: 12, letterSpacing: 2),
      ),
      Text(
        '#${s['orden']}  ${numero != null ? '#$numero ' : ''}${s['nombre']}',
        textAlign: TextAlign.center,
        style: const TextStyle(color: Colors.white, fontSize: 22, fontWeight: FontWeight.bold),
      ),
    ];
  }

  Widget _selectorTipo() {
    if (_tipos.isEmpty) {
      final nombre = _turno?['lanzador_nombre'] as String?;
      return Text(
        _filtrado && nombre != null
            ? '$nombre no tiene tipos de pitcheo registrados. Agregaselos en su perfil. Los lanzamientos se guardan sin tipo.'
            : 'No hay tipos de pitcheo registrados. Los lanzamientos se guardan sin tipo.',
        style: const TextStyle(color: _textoSuave, fontSize: 12),
      );
    }
    return Wrap(
      spacing: 8,
      runSpacing: 4,
      children: [
        for (final t in _tipos)
          ChoiceChip(
            label: Text(t['nombre'] as String),
            selected: _tipoId == t['tipo_lanzamiento_id'],
            selectedColor: _cian,
            backgroundColor: _superficie,
            labelStyle: TextStyle(
              color: _tipoId == t['tipo_lanzamiento_id'] ? Colors.black : Colors.white,
            ),
            onSelected: (sel) => setState(
              () => _tipoId = sel ? t['tipo_lanzamiento_id'] as int : null,
            ),
          ),
      ],
    );
  }

  Widget _ultimosLanzamientos() {
    if (_lanzamientos.isEmpty) return const SizedBox.shrink();
    final texto = _lanzamientos.map((l) {
      final r = _etiquetasLanzamiento[l['resultado']] ?? '${l['resultado']}';
      final tipo = l['tipo'] as String?;
      return '${l['numero']}. $r${tipo != null ? ' ($tipo)' : ''}';
    }).join('\n');
    return Padding(
      padding: const EdgeInsets.only(top: 12),
      child: Text(texto, style: const TextStyle(color: _textoSuave, fontSize: 13)),
    );
  }

  Widget _cuerpo() {
    final hayTurno = _turno != null;
    final nuevoRival = _siguiente?['nuevo'] == true;
    final hayCorredores =
        ((_corr?['corredores'] as List?) ?? const []).isNotEmpty;
    return ListView(
      padding: const EdgeInsets.all(12),
      children: [
        VivoLinescore(
          riv: _serie('carreras_rival', !_local),
          nos: _serie('carreras_propias', _local),
          entradaActual: _entrada,
          batearRival: !_bateaPropio,
          propioArriba: !_local,
        ),
        const SizedBox(height: 8),
        if (hayTurno) _tarjetasTurno() else _tarjetaSiguiente(),
        const SizedBox(height: 8),
        _filaCampo(hayTurno),
        const SizedBox(height: 8),
        if (hayTurno)
          ..._controlesLanzamiento()
        else
          ..._controlesSinTurno(nuevoRival),
        const SizedBox(height: 8),
        Row(
          children: [
            Expanded(
              child: VivoBotonSecundario(
                texto: 'Jugada de corredores',
                onTap: (_ocupado || !hayCorredores) ? null : _jugadaCorredores,
              ),
            ),
            const SizedBox(width: 6),
            SizedBox(
              width: 96,
              child: VivoBotonSecundario(
                texto: '\u21B6 Deshacer',
                apagado: true,
                onTap: _ocupado ? null : _deshacer,
              ),
            ),
          ],
        ),
        if (_ultimaJugada != null) ...[
          const SizedBox(height: 6),
          VivoBotonSecundario(
            texto: 'DESHACER JUGADA (${_etiquetasJugada[_ultimaJugada!['tipo']] ?? ''})',
            onTap: _ocupado ? null : _deshacerJugada,
          ),
        ],
        const SizedBox(height: 12),
        const Text(
          'Al cerrar cada turno se registran los corredores y las carreras. Los robos, wild pitches, passed balls y balks se anotan con "Jugada de corredores".',
          textAlign: TextAlign.center,
          style: TextStyle(color: _textoSuave, fontSize: 12),
        ),
      ],
    );
  }

  Widget _tituloVivo() {
    final j = _juego;
    final alta = ((j?['mitad_actual'] as String?) ?? 'alta') == 'alta';
    final entrada = (j?['entrada_actual'] as int?) ?? 1;
    return Row(
      mainAxisSize: MainAxisSize.min,
      children: [
        Container(
          width: 10,
          height: 10,
          decoration: const BoxDecoration(
            color: VivoColores.naranja,
            shape: BoxShape.circle,
          ),
        ),
        const SizedBox(width: 8),
        Text(
          'EN VIVO \u00B7 ${alta ? '\u25B2' : '\u25BC'} $entrada',
          style: const TextStyle(fontWeight: FontWeight.bold, letterSpacing: 1),
        ),
      ],
    );
  }

  List<int?> _serie(String col, bool esLocal) {
    var n = _entrada;
    for (final e in _entradas) {
      final k = (e['numero'] as int?) ?? 0;
      if (k > n) n = k;
    }
    final r = List<int?>.filled(n, null);
    for (final e in _entradas) {
      final k = (e['numero'] as int?) ?? 0;
      if (k < 1 || k > _entrada) continue;
      if (esLocal && k == _entrada && _mitad == 'alta') continue;
      r[k - 1] = (e[col] as int?) ?? 0;
    }
    return r;
  }

  Widget _tarjetasTurno() {
    final t = _turno!;
    final numero = t['bateador_numero'];
    final nombre = (t['bateador_nombre'] as String?) ?? '?';
    final lanzador = t['lanzador_nombre'] as String?;
    final propio = t['propio'] == 1;
    return IntrinsicHeight(
      child: Row(
        crossAxisAlignment: CrossAxisAlignment.stretch,
        children: [
          Expanded(
            child: VivoTarjeta(
              etiqueta: 'LANZADOR',
              titulo: lanzador ?? 'Sin identificar',
              detalle: '${_lanzamientos.length} lanzamientos en este turno',
            ),
          ),
          const SizedBox(width: 8),
          Expanded(
            child: VivoTarjeta(
              etiqueta: propio ? 'BATEADOR' : 'BATEADOR (RIV)',
              titulo: '${numero != null ? '#$numero \u00B7 ' : ''}$nombre',
              detalle: 'Orden al bate: ${t['orden']}',
            ),
          ),
        ],
      ),
    );
  }

  Widget _tarjetaSiguiente() {
    return Container(
      width: double.infinity,
      padding: const EdgeInsets.all(12),
      decoration: BoxDecoration(
        color: VivoColores.tarjeta,
        borderRadius: BorderRadius.circular(10),
        border: Border.all(color: VivoColores.borde),
      ),
      child: Column(
        children: [..._contenidoSiguiente(), ..._infoLanzadorRival()],
      ),
    );
  }

  bool _base(int b) {
    final lista = (_corr?['corredores'] as List?) ?? const [];
    return lista.any((c) => (c as Map)['base'] == b);
  }

  String _notaBases() {
    final n = [
      if (_base(1)) '1ra',
      if (_base(2)) '2da',
      if (_base(3)) '3ra',
    ];
    if (n.isEmpty) return 'Bases vacias';
    if (n.length == 3) return 'Bases llenas';
    return n.join(' y ');
  }

  Widget _filaCampo(bool hayTurno) {
    final t = _turno;
    final diamante = VivoDiamante(
      primera: _base(1),
      segunda: _base(2),
      tercera: _base(3),
      nota: _notaBases(),
    );
    final cuenta = VivoCuenta(
      bolas: hayTurno ? ((t!['bolas'] as int?) ?? 0) : 0,
      strikes: hayTurno ? ((t!['strikes'] as int?) ?? 0) : 0,
      outs: _outs,
    );
    if (!hayTurno) {
      return SizedBox(
        height: 160,
        child: Row(
          mainAxisAlignment: MainAxisAlignment.spaceAround,
          crossAxisAlignment: CrossAxisAlignment.center,
          children: [
            SizedBox(width: 76, child: cuenta),
            SizedBox(width: 90, child: diamante),
          ],
        ),
      );
    }
    return SizedBox(
      height: 188,
      child: Row(
        mainAxisAlignment: MainAxisAlignment.spaceBetween,
        crossAxisAlignment: CrossAxisAlignment.center,
        children: [
          SizedBox(width: 76, child: cuenta),
          const VivoZonaStrike(),
          SizedBox(width: 76, child: diamante),
        ],
      ),
    );
  }

  String? _nombreTipoSel() {
    for (final t in _tipos) {
      if (t['tipo_lanzamiento_id'] == _tipoId) return t['nombre'] as String;
    }
    return null;
  }

  void _elegirTipo(String nombre) {
    for (final t in _tipos) {
      if (t['nombre'] == nombre) {
        final id = t['tipo_lanzamiento_id'] as int;
        setState(() => _tipoId = _tipoId == id ? null : id);
        return;
      }
    }
  }

  List<String> _secuencia() {
    return [
      for (final l in _lanzamientos)
        () {
          final r = _etiquetasLanzamiento[l['resultado']] ?? '${l['resultado']}';
          final tipo = l['tipo'] as String?;
          return tipo != null
              ? '${l['numero']} $tipo \u00B7 $r'
              : '${l['numero']} $r';
        }(),
    ];
  }

  List<Widget> _controlesLanzamiento() {
    return [
      if (_tipos.isEmpty)
        _selectorTipo()
      else
        VivoChipsLanzamiento(
          tipos: [for (final t in _tipos) t['nombre'] as String],
          seleccionado: _nombreTipoSel(),
          onSeleccion: _elegirTipo,
        ),
      const SizedBox(height: 8),
      VivoSecuencia(lanzamientos: _secuencia()),
      const SizedBox(height: 8),
      VivoRejillaResultados(
        botones: [
          VivoBotonResultado(
            'Bola',
            onTap: _ocupado ? null : () => _lanzar('bola'),
          ),
          VivoBotonResultado(
            'Strike\ncantado',
            color: VivoColores.naranja,
            destacado: true,
            onTap: _ocupado ? null : () => _lanzar('strike_cantado'),
          ),
          VivoBotonResultado(
            'Strike\nswing',
            color: VivoColores.naranja,
            destacado: true,
            onTap: _ocupado ? null : () => _lanzar('strike_swing'),
          ),
          VivoBotonResultado(
            'Foul',
            onTap: _ocupado ? null : () => _lanzar('foul'),
          ),
          VivoBotonResultado(
            'Hit',
            color: VivoColores.acento,
            destacado: true,
            onTap: _ocupado
                ? null
                : () => _enJuego(const ['sencillo', 'doble', 'triple', 'home_run']),
          ),
          VivoBotonResultado(
            'Out',
            onTap: _ocupado
                ? null
                : () => _enJuego(const ['out_roletazo', 'out_elevado', 'out_linea']),
          ),
          VivoBotonResultado(
            'Error',
            onTap: _ocupado
                ? null
                : () => _lanzar('en_juego', resultadoTurno: 'error'),
          ),
          VivoBotonResultado(
            'Golpeado',
            onTap: _ocupado
                ? null
                : () => _lanzar('golpeado', resultadoTurno: 'golpeado'),
          ),
        ],
      ),
    ];
  }

  List<Widget> _controlesSinTurno(bool nuevoRival) {
    if (_pendiente != null) {
      return [
        VivoBotonPrincipal(
          texto: 'ANOTAR CORREDORES',
          onTap: _ocupado
              ? null
              : () {
                  _ignorarPendiente = false;
                  _resolverPendiente();
                },
        ),
      ];
    }
    if (_siguiente != null) {
      return [
        VivoBotonPrincipal(
          texto: nuevoRival ? 'AGREGAR BATEADOR RIVAL' : 'INICIAR TURNO',
          onTap: _ocupado
              ? null
              : (nuevoRival ? _agregarRival : _iniciarTurno),
        ),
      ];
    }
    return const [];
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: _fondo,
      appBar: AppBar(
        backgroundColor: _fondo,
        foregroundColor: Colors.white,
        title: _tituloVivo(),
      ),
      body: (_cargando || _juego == null)
          ? const Center(child: CircularProgressIndicator())
          : _cuerpo(),
    );
  }
}

class _DialogoRival extends StatefulWidget {
  final int orden;

  const _DialogoRival({required this.orden});

  @override
  State<_DialogoRival> createState() => _DialogoRivalState();
}

class _DialogoRivalState extends State<_DialogoRival> {
  final TextEditingController _nombre = TextEditingController();
  final TextEditingController _numero = TextEditingController();

  @override
  void dispose() {
    _nombre.dispose();
    _numero.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return AlertDialog(
      title: Text('Bateador ${widget.orden} del rival'),
      content: Column(
        mainAxisSize: MainAxisSize.min,
        children: [
          TextField(
            controller: _nombre,
            textCapitalization: TextCapitalization.words,
            decoration: const InputDecoration(labelText: 'Nombre (opcional)'),
          ),
          TextField(
            controller: _numero,
            keyboardType: TextInputType.number,
            decoration: const InputDecoration(labelText: 'Numero (opcional)'),
          ),
        ],
      ),
      actions: [
        TextButton(
          onPressed: () => Navigator.pop(context),
          child: const Text('CANCELAR'),
        ),
        TextButton(
          onPressed: () {
            final n = _nombre.text.trim();
            Navigator.pop(context, {
              'nombre': n.isEmpty ? 'Bateador ${widget.orden}' : n,
              'numero': int.tryParse(_numero.text.trim()),
            });
          },
          child: const Text('AGREGAR'),
        ),
      ],
    );
  }
}

class _DialogoLanzadorRival extends StatefulWidget {
  final List<Map<String, dynamic>> existentes;
  final List<Map<String, dynamic>> tipos;

  const _DialogoLanzadorRival({required this.existentes, required this.tipos});

  @override
  State<_DialogoLanzadorRival> createState() => _DialogoLanzadorRivalState();
}

class _DialogoLanzadorRivalState extends State<_DialogoLanzadorRival> {
  final TextEditingController _nombre = TextEditingController();
  final TextEditingController _numero = TextEditingController();
  int? _sel;
  String? _mano;
  final Set<int> _tiposSel = {};

  @override
  void dispose() {
    _nombre.dispose();
    _numero.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final nuevo = _sel == null;
    return AlertDialog(
      title: const Text('Lanzador del rival'),
      content: SingleChildScrollView(
        child: Column(
          mainAxisSize: MainAxisSize.min,
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            if (widget.existentes.isNotEmpty)
              DropdownButton<int?>(
                isExpanded: true,
                value: _sel,
                items: [
                  const DropdownMenuItem<int?>(
                    value: null,
                    child: Text('Nuevo lanzador'),
                  ),
                  for (final e in widget.existentes)
                    DropdownMenuItem<int?>(
                      value: e['jugador_id'] as int,
                      child: Text(
                        '${e['numero'] != null ? '#${e['numero']} ' : ''}${e['nombre']}',
                        overflow: TextOverflow.ellipsis,
                      ),
                    ),
                ],
                onChanged: (v) => setState(() => _sel = v),
              ),
            if (nuevo) ...[
              TextField(
                controller: _nombre,
                textCapitalization: TextCapitalization.words,
                decoration: const InputDecoration(labelText: 'Nombre (opcional)'),
              ),
              TextField(
                controller: _numero,
                keyboardType: TextInputType.number,
                decoration: const InputDecoration(labelText: 'Numero (opcional)'),
              ),
              const SizedBox(height: 12),
              Wrap(
                spacing: 8,
                children: [
                  for (final m in const ['derecho', 'zurdo'])
                    ChoiceChip(
                      label: Text(m == 'derecho' ? 'Derecho' : 'Zurdo'),
                      selected: _mano == m,
                      onSelected: (s) => setState(() => _mano = s ? m : null),
                    ),
                ],
              ),
              const SizedBox(height: 12),
              const Text('Tipos de pitcheo que tira'),
              const SizedBox(height: 4),
              Wrap(
                spacing: 8,
                runSpacing: 4,
                children: [
                  for (final t in widget.tipos)
                    FilterChip(
                      label: Text(t['nombre'] as String),
                      selected: _tiposSel.contains(t['tipo_lanzamiento_id']),
                      onSelected: (s) => setState(() {
                        final id = t['tipo_lanzamiento_id'] as int;
                        if (s) {
                          _tiposSel.add(id);
                        } else {
                          _tiposSel.remove(id);
                        }
                      }),
                    ),
                ],
              ),
            ],
          ],
        ),
      ),
      actions: [
        TextButton(
          onPressed: () => Navigator.pop(context),
          child: const Text('CANCELAR'),
        ),
        TextButton(
          onPressed: () {
            if (!nuevo) {
              Navigator.pop(context, {'id': _sel});
              return;
            }
            final n = _nombre.text.trim();
            Navigator.pop(context, {
              'id': null,
              'nombre': n.isEmpty ? 'Lanzador rival' : n,
              'numero': int.tryParse(_numero.text.trim()),
              'mano': _mano,
              'tipos': _tiposSel.toList(),
            });
          },
          child: const Text('ACEPTAR'),
        ),
      ],
    );
  }
}

class _DialogoCorredores extends StatefulWidget {
  final Map<String, dynamic> pendiente;

  const _DialogoCorredores({required this.pendiente});

  @override
  State<_DialogoCorredores> createState() => _DialogoCorredoresState();
}

class _DialogoCorredoresState extends State<_DialogoCorredores> {
  static const Set<String> _outsBateador = {
    'ponche',
    'out_roletazo',
    'out_elevado',
    'out_linea',
  };

  late final String _resultado;
  late final List<Map<String, dynamic>> _corredores;
  final Map<int, String> _destinos = {};

  @override
  void initState() {
    super.initState();
    _resultado = widget.pendiente['resultado'] as String;
    _corredores =
        (widget.pendiente['corredores'] as List).cast<Map<String, dynamic>>();
    _destinos[0] = _bateadorPorDefecto();
    final ocupadas = {for (final c in _corredores) c['base'] as int};
    final f1 = ocupadas.contains(1);
    final f2 = f1 && ocupadas.contains(2);
    final f3 = f2 && ocupadas.contains(3);
    for (final c in _corredores) {
      final b = c['base'] as int;
      _destinos[b] = _corredorPorDefecto(b, f1, f2, f3);
    }
  }

  String _bateadorPorDefecto() {
    switch (_resultado) {
      case 'doble':
        return '2';
      case 'triple':
        return '3';
      case 'home_run':
        return 'anota';
      case 'sencillo':
      case 'boleto':
      case 'golpeado':
      case 'error':
        return '1';
      default:
        return 'out';
    }
  }

  String _avanzar(int base, int n) {
    final d = base + n;
    return d >= 4 ? 'anota' : '$d';
  }

  String _corredorPorDefecto(int b, bool f1, bool f2, bool f3) {
    switch (_resultado) {
      case 'home_run':
        return 'anota';
      case 'sencillo':
        return _avanzar(b, 1);
      case 'doble':
        return _avanzar(b, 2);
      case 'triple':
        return _avanzar(b, 3);
      case 'boleto':
      case 'golpeado':
      case 'error':
        {
          final forzado = b == 1 ? f1 : (b == 2 ? f2 : f3);
          return forzado ? _avanzar(b, 1) : 'queda';
        }
      default:
        return 'queda';
    }
  }

  List<MapEntry<String, String>> _opciones(int origen) {
    if (origen == 0) {
      return const [
        MapEntry('1', '1B'),
        MapEntry('2', '2B'),
        MapEntry('3', '3B'),
        MapEntry('anota', 'Anota'),
      ];
    }
    return [
      const MapEntry('queda', 'Se queda'),
      for (var d = origen + 1; d <= 3; d++) MapEntry('$d', '${d}B'),
      const MapEntry('anota', 'Anota'),
      const MapEntry('out', 'Out'),
    ];
  }

  String? _conflicto() {
    final ocupadas = <int, int>{};
    for (final e in _destinos.entries) {
      int? base;
      if (e.value == 'queda') {
        base = e.key;
      } else if (e.value == '1' || e.value == '2' || e.value == '3') {
        base = int.parse(e.value);
      }
      if (base == null || base == 0) continue;
      ocupadas[base] = (ocupadas[base] ?? 0) + 1;
    }
    if (ocupadas.values.any((n) => n > 1)) {
      return 'Dos jugadores quedaron en la misma base.';
    }
    return null;
  }

  Widget _bloque(int origen, String titulo) {
    final fijo = origen == 0 && _outsBateador.contains(_resultado);
    return Padding(
      padding: const EdgeInsets.only(bottom: 10),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text(titulo, style: const TextStyle(fontWeight: FontWeight.bold)),
          if (fijo)
            const Text('Out')
          else
            Wrap(
              spacing: 8,
              children: [
                for (final o in _opciones(origen))
                  ChoiceChip(
                    label: Text(o.value),
                    selected: _destinos[origen] == o.key,
                    onSelected: (_) => setState(() => _destinos[origen] = o.key),
                  ),
              ],
            ),
        ],
      ),
    );
  }

  String _nombre(Object? numero, Object? nombre) =>
      '${numero != null ? '#$numero ' : ''}$nombre';

  @override
  Widget build(BuildContext context) {
    final conflicto = _conflicto();
    final carreras = _destinos.values.where((d) => d == 'anota').length;
    final outsExtra =
        _corredores.where((c) => _destinos[c['base'] as int] == 'out').length;
    final outs = (widget.pendiente['outs'] as int?) ?? 0;
    final termina = outsExtra > 0 && outs + outsExtra >= 3;
    return AlertDialog(
      title: Text('Corredores: ${_etiquetas[_resultado] ?? _resultado}'),
      content: SingleChildScrollView(
        child: Column(
          mainAxisSize: MainAxisSize.min,
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            _bloque(
              0,
              'Bateador: ${_nombre(widget.pendiente['bateador_numero'], widget.pendiente['bateador_nombre'])}',
            ),
            for (final c in _corredores)
              _bloque(
                c['base'] as int,
                '${c['base']}B: ${_nombre(c['numero'], c['nombre'])}',
              ),
            const SizedBox(height: 4),
            Text('Carreras en la jugada: $carreras'),
            if (termina)
              const Text('Con estos outs termina la mitad de la entrada.'),
            if (conflicto != null)
              Text(conflicto, style: const TextStyle(color: _rojo)),
          ],
        ),
      ),
      actions: [
        TextButton(
          onPressed: () => Navigator.pop(context),
          child: const Text('CANCELAR'),
        ),
        TextButton(
          onPressed: conflicto != null
              ? null
              : () {
                  final res = <Map<String, dynamic>>[
                    for (final e in _destinos.entries)
                      {'origen': e.key, 'destino': e.value},
                  ];
                  Navigator.pop(context, res);
                },
          child: const Text('ACEPTAR'),
        ),
      ],
    );
  }
}

const Map<String, String> _etiquetasJugada = {
  'robo': 'Robo de base',
  'robo_frustrado': 'Robo frustrado',
  'wild_pitch': 'Wild pitch',
  'passed_ball': 'Passed ball',
  'balk': 'Balk',
};

class _DialogoJugada extends StatefulWidget {
  final List<Map<String, dynamic>> corredores;
  final int outs;

  const _DialogoJugada({required this.corredores, required this.outs});

  @override
  State<_DialogoJugada> createState() => _DialogoJugadaState();
}

class _DialogoJugadaState extends State<_DialogoJugada> {
  String _tipo = 'robo';
  final Map<int, String> _destinos = {};

  @override
  void initState() {
    super.initState();
    _defecto();
  }

  Set<int> get _bases => {for (final c in widget.corredores) c['base'] as int};

  void _defecto() {
    _destinos.clear();
    final bases = _bases;
    for (final b in bases) {
      _destinos[b] = 'queda';
    }
    if (_tipo == 'wild_pitch' || _tipo == 'passed_ball' || _tipo == 'balk') {
      for (final b in bases) {
        _destinos[b] = b >= 3 ? 'anota' : '${b + 1}';
      }
      return;
    }
    final menor = bases.reduce((a, b) => a < b ? a : b);
    if (_tipo == 'robo_frustrado') {
      _destinos[menor] = 'out';
    } else if (menor >= 3) {
      _destinos[menor] = 'anota';
    } else if (!bases.contains(menor + 1)) {
      _destinos[menor] = '${menor + 1}';
    }
  }

  List<MapEntry<String, String>> _opciones(int origen) {
    return [
      const MapEntry('queda', 'Se queda'),
      for (var d = origen + 1; d <= 3; d++) MapEntry('$d', '${d}B'),
      const MapEntry('anota', 'Anota'),
      const MapEntry('out', 'Out'),
    ];
  }

  String? _conflicto() {
    final ocupadas = <int, int>{};
    for (final e in _destinos.entries) {
      int? base;
      if (e.value == 'queda') {
        base = e.key;
      } else if (e.value == '2' || e.value == '3') {
        base = int.parse(e.value);
      }
      if (base == null) continue;
      ocupadas[base] = (ocupadas[base] ?? 0) + 1;
    }
    if (ocupadas.values.any((n) => n > 1)) {
      return 'Dos jugadores quedaron en la misma base.';
    }
    return null;
  }

  Widget _bloque(Map<String, dynamic> c) {
    final base = c['base'] as int;
    final numero = c['numero'];
    return Padding(
      padding: const EdgeInsets.only(bottom: 10),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text(
            '${base}B: ${numero != null ? '#$numero ' : ''}${c['nombre']}',
            style: const TextStyle(fontWeight: FontWeight.bold),
          ),
          Wrap(
            spacing: 8,
            children: [
              for (final o in _opciones(base))
                ChoiceChip(
                  label: Text(o.value),
                  selected: _destinos[base] == o.key,
                  onSelected: (_) => setState(() => _destinos[base] = o.key),
                ),
            ],
          ),
        ],
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final conflicto = _conflicto();
    final hayCambio = _destinos.values.any((d) => d != 'queda');
    final carreras = _destinos.values.where((d) => d == 'anota').length;
    final outsN = _destinos.values.where((d) => d == 'out').length;
    final termina = outsN > 0 && widget.outs + outsN >= 3;
    return AlertDialog(
      title: const Text('Jugada de corredores'),
      content: SingleChildScrollView(
        child: Column(
          mainAxisSize: MainAxisSize.min,
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Wrap(
              spacing: 8,
              runSpacing: 4,
              children: [
                for (final e in _etiquetasJugada.entries)
                  ChoiceChip(
                    label: Text(e.value),
                    selected: _tipo == e.key,
                    onSelected: (_) => setState(() {
                      _tipo = e.key;
                      _defecto();
                    }),
                  ),
              ],
            ),
            const SizedBox(height: 12),
            for (final c in widget.corredores) _bloque(c),
            Text('Carreras: $carreras  -  Outs: $outsN'),
            if (termina)
              const Text('Con estos outs termina la mitad de la entrada.'),
            if (conflicto != null)
              Text(conflicto, style: const TextStyle(color: _rojo)),
            if (conflicto == null && !hayCambio)
              const Text('Elige que paso con algun corredor.'),
          ],
        ),
      ),
      actions: [
        TextButton(
          onPressed: () => Navigator.pop(context),
          child: const Text('CANCELAR'),
        ),
        TextButton(
          onPressed: (conflicto != null || !hayCambio)
              ? null
              : () => Navigator.pop(context, {
                    'tipo': _tipo,
                    'movs': [
                      for (final e in _destinos.entries)
                        {'origen': e.key, 'destino': e.value},
                    ],
                  }),
          child: const Text('ACEPTAR'),
        ),
      ],
    );
  }
}
