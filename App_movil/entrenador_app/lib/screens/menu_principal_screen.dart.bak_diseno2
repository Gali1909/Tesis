import 'package:flutter/material.dart';
import 'package:flutter/services.dart';
import 'equipos_screen.dart';
import 'record_juegos_screen.dart';
import 'roster_screen.dart';

const Color _fondo = Color(0xFF14171C);
const Color _superficie = Color(0xFF1E232B);
const Color _acento = Color(0xFF0ABDCF);
const Color _acento2 = Color(0xFF0A7FCF);
const Color _textoSuave = Color(0xFF9AA4B2);

class MenuPrincipalScreen extends StatelessWidget {
  final int equipoId;
  final String nombreEquipo;

  const MenuPrincipalScreen({
    super.key,
    required this.equipoId,
    required this.nombreEquipo,
  });

  Widget _encabezado() {
    return Container(
      width: double.infinity,
      padding: const EdgeInsets.fromLTRB(24, 24, 24, 32),
      decoration: const BoxDecoration(
        gradient: LinearGradient(
          begin: Alignment.topLeft,
          end: Alignment.bottomRight,
          colors: [Color(0xFF0E3A44), _fondo],
        ),
      ),
      child: Row(
        children: [
          Container(
            width: 64,
            height: 64,
            decoration: BoxDecoration(
              shape: BoxShape.circle,
              color: const Color(0x260ABDCF),
              border: Border.all(color: _acento, width: 2),
            ),
            child: const Icon(Icons.sports_baseball, color: _acento, size: 34),
          ),
          const SizedBox(width: 16),
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                const Text(
                  'ENTRENADOR',
                  style: TextStyle(
                    color: _acento,
                    fontSize: 12,
                    fontWeight: FontWeight.bold,
                    letterSpacing: 3,
                  ),
                ),
                const SizedBox(height: 4),
                Text(
                  nombreEquipo,
                  maxLines: 1,
                  overflow: TextOverflow.ellipsis,
                  style: const TextStyle(
                    color: Colors.white,
                    fontSize: 28,
                    fontWeight: FontWeight.bold,
                  ),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }

  Widget _tarjeta(
    BuildContext context, {
    required IconData icono,
    required String titulo,
    required String subtitulo,
    required Widget destino,
  }) {
    return Padding(
      padding: const EdgeInsets.only(bottom: 14),
      child: Material(
        color: Colors.transparent,
        child: InkWell(
          borderRadius: BorderRadius.circular(20),
          onTap: () => Navigator.push(
            context,
            MaterialPageRoute(builder: (context) => destino),
          ),
          child: Ink(
            padding: const EdgeInsets.all(16),
            decoration: BoxDecoration(
              color: _superficie,
              borderRadius: BorderRadius.circular(20),
              border: Border.all(color: const Color(0x2E0ABDCF)),
            ),
            child: Row(
              children: [
                Container(
                  width: 56,
                  height: 56,
                  decoration: BoxDecoration(
                    borderRadius: BorderRadius.circular(16),
                    gradient: const LinearGradient(
                      begin: Alignment.topLeft,
                      end: Alignment.bottomRight,
                      colors: [_acento, _acento2],
                    ),
                  ),
                  child: Icon(icono, color: Colors.white, size: 28),
                ),
                const SizedBox(width: 16),
                Expanded(
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.start,
                    children: [
                      Text(
                        titulo,
                        style: const TextStyle(
                          color: Colors.white,
                          fontSize: 17,
                          fontWeight: FontWeight.bold,
                        ),
                      ),
                      const SizedBox(height: 4),
                      Text(
                        subtitulo,
                        style: const TextStyle(color: _textoSuave, fontSize: 13),
                      ),
                    ],
                  ),
                ),
                const Icon(Icons.arrow_forward_ios_rounded,
                    color: Color(0xFF5B6675), size: 16),
              ],
            ),
          ),
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return AnnotatedRegion<SystemUiOverlayStyle>(
      value: SystemUiOverlayStyle.light,
      child: Scaffold(
        backgroundColor: _fondo,
        body: ListView(
          padding: EdgeInsets.zero,
          children: [
            _encabezado(),
            Padding(
              padding: const EdgeInsets.fromLTRB(20, 8, 20, 24),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  const Padding(
                    padding: EdgeInsets.only(left: 4, bottom: 16),
                    child: Text(
                      'Que quieres hacer hoy?',
                      style: TextStyle(color: _textoSuave, fontSize: 15),
                    ),
                  ),
                  _tarjeta(
                    context,
                    icono: Icons.groups,
                    titulo: 'Roster',
                    subtitulo: 'Jugadores de tu equipo',
                    destino: RosterScreen(
                      equipoId: equipoId,
                      nombreEquipo: nombreEquipo,
                    ),
                  ),
                  _tarjeta(
                    context,
                    icono: Icons.sports_baseball,
                    titulo: 'Equipos y rivales',
                    subtitulo: 'Crear rivales y ver sus jugadores',
                    destino: const EquiposScreen(),
                  ),
                  _tarjeta(
                    context,
                    icono: Icons.emoji_events,
                    titulo: 'Record y juegos',
                    subtitulo: 'Ganados, perdidos y marcadores',
                    destino: const RecordJuegosScreen(),
                  ),
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }
}
