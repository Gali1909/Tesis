                  _tarjeta(
                    context,
                    indice: 3,
                    icono: Icons.person_search,
                    titulo: 'Jugadores libres',
                    subtitulo: 'Jugadores dejados en libertad',
                    color: const Color(0xFF3DDC84),
                    destino: JugadoresLibresScreen(
                      equipoId: equipoId,
                      nombreEquipo: nombreEquipo,
