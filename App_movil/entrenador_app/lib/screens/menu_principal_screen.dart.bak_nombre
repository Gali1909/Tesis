                  ),
                  _tarjeta(
                    context,
                    indice: 0,
                    icono: Icons.groups,
                    titulo: 'Roster',
                    subtitulo: 'Jugadores de tu equipo',
                    color: _cian,
                    destino: RosterScreen(
                      equipoId: equipoId,
                      nombreEquipo: nombreEquipo,
