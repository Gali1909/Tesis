const Color _fondo = Color(0xFF14171C);
const Color _superficie = Color(0xFF1E232B);
const Color _cian = Color(0xFF0ABDCF);
const Color _ambar = Color(0xFFFFB703);
const Color _rojo = Color(0xFFE63946);
const Color _textoSuave = Color(0xFF9AA4B2);

/// Dibuja un diamante de beisbol tenue como fondo del encabezado.
class _CampoPainter extends CustomPainter {
  const _CampoPainter();

  @override
  void paint(Canvas canvas, Size size) {
    final linea = Paint()
      ..color = const Color(0x2E0ABDCF)
      ..style = PaintingStyle.stroke
      ..strokeWidth = 2;
    final relleno = Paint()..color = const Color(0x400ABDCF);

    final centro = Offset(size.width * 0.88, size.height * 0.62);
    final r = size.height * 0.95;

    Path rombo(double radio) => Path()
      ..moveTo(centro.dx, centro.dy - radio)
      ..lineTo(centro.dx + radio, centro.dy)
      ..lineTo(centro.dx, centro.dy + radio)
      ..lineTo(centro.dx - radio, centro.dy)
      ..close();

    canvas.drawPath(rombo(r), linea);
    canvas.drawPath(rombo(r * 0.55), linea);
    canvas.drawCircle(centro, r * 0.14, linea);

    final bases = [
      Offset(centro.dx, centro.dy - r),
      Offset(centro.dx + r, centro.dy),
      Offset(centro.dx - r, centro.dy),
      Offset(centro.dx, centro.dy + r),
    ];
    for (final p in bases) {
      canvas.save();
      canvas.translate(p.dx, p.dy);
      canvas.rotate(0.785398);
      canvas.drawRect(
        Rect.fromCenter(center: Offset.zero, width: 14, height: 14),
        relleno,
      );
      canvas.restore();
    }
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}

/// Linea con puntadas rojas, como la costura de una pelota.
class _CosturaPainter extends CustomPainter {
  const _CosturaPainter();

  @override
  void paint(Canvas canvas, Size size) {
    final base = Paint()
      ..color = const Color(0x33E63946)
      ..strokeWidth = 1.5;
    final puntada = Paint()
      ..color = _rojo
      ..strokeWidth = 2
      ..strokeCap = StrokeCap.round;
    final mitad = size.height / 2;
    canvas.drawLine(Offset(0, mitad), Offset(size.width, mitad), base);
    for (double x = 6; x < size.width - 10; x += 14) {
      canvas.drawLine(Offset(x, 1), Offset(x + 6, size.height - 1), puntada);
    }
  }

  @override
  bool shouldRepaint(covariant CustomPainter oldDelegate) => false;
}

final ValueNotifier<int> _refrescoRecord = ValueNotifier<int>(0);

/// Etiqueta con el record G - P de la temporada actual en el encabezado.
class _RecordChip extends StatefulWidget {
  final int anio;

  const _RecordChip({required this.anio});

  @override
  State<_RecordChip> createState() => _RecordChipState();
}

class _RecordChipState extends State<_RecordChip> {
  Map<String, int>? _record;

  @override
  void initState() {
    super.initState();
    _refrescoRecord.addListener(_cargar);
    _cargar();
  }

  @override
  void dispose() {
    _refrescoRecord.removeListener(_cargar);
    super.dispose();
  }

  Future<void> _cargar() async {
    final r = await DatabaseHelper.instance.recordEquipo(anio: widget.anio);
    if (!mounted) return;
    setState(() => _record = r);
  }

  @override
  Widget build(BuildContext context) {
    final r = _record;
    String texto = '-- G - -- P';
    if (r != null) {
      final g = r['g'] ?? 0;
      final p = r['p'] ?? 0;
      final e = r['e'] ?? 0;
      texto = e > 0 ? '$g G - $p P - $e E' : '$g G - $p P';
    }
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 6),
      decoration: BoxDecoration(
        borderRadius: BorderRadius.circular(20),
        border: Border.all(color: _cian),
        color: const Color(0x1F0ABDCF),
      ),
      child: Row(
        mainAxisSize: MainAxisSize.min,
        children: [
          const Icon(Icons.emoji_events, color: _cian, size: 14),
          const SizedBox(width: 6),
          Text(
            texto,
            style: const TextStyle(
              color: Colors.white,
              fontSize: 11,
              fontWeight: FontWeight.bold,
              letterSpacing: 2,
            ),
          ),
        ],
      ),
    );
  }
}

class MenuPrincipalScreen extends StatelessWidget {
  final int equipoId;
  final String nombreEquipo;

  const MenuPrincipalScreen({
    super.key,
    required this.equipoId,
    required this.nombreEquipo,
