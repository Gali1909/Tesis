            child: Ink(
              decoration: BoxDecoration(
                color: _superficie,
                borderRadius: BorderRadius.circular(20),
                border: Border.all(color: color.withAlpha(80)),
              ),
              child: ClipRRect(
                borderRadius: BorderRadius.circular(20),
                child: Stack(
                  children: [
                    Positioned(
                      right: 16,
                      bottom: -12,
                      child: Text(
                        numero,
                        style: TextStyle(
                          fontSize: 76,
                          height: 1,
                          fontWeight: FontWeight.w900,
                          color: color.withAlpha(30),
                        ),
