          Padding(
            padding: EdgeInsets.fromLTRB(24, arriba + 28, 24, 30),
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Row(
                  children: [
                    Container(
                      width: 64,
                      height: 64,
                      decoration: BoxDecoration(
                        shape: BoxShape.circle,
                        color: const Color(0x260ABDCF),
                        border: Border.all(color: _cian, width: 2),
                      ),
                      child: const Icon(Icons.sports_baseball,
                          color: _cian, size: 34),
                    ),
                    const SizedBox(width: 16),
                    Expanded(
                      child: Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          const Text(
                            'ENTRENADOR',
                            style: TextStyle(
                              color: _cian,
                              fontSize: 12,
                              fontWeight: FontWeight.bold,
                              letterSpacing: 3,
                            ),
                          ),
                          const SizedBox(height: 4),
                          Text(
                            nombreEquipo,
                            maxLines: 1,
