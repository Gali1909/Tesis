import 'package:flutter/material.dart';
import 'equipos_screen.dart';
import 'record_juegos_screen.dart';
import 'roster_screen.dart';

const Color _colorFondoOscuro = Color(0xFF14171C);
const Color _colorAcento = Color(0xFF0ABDCF);

class MenuPrincipalScreen extends StatelessWidget {
  final int equipoId;
  final String nombreEquipo;

  const MenuPrincipalScreen({
    super.key,
    required this.equipoId,
    required this.nombreEquipo,
  });

  Widget _boton(
    BuildContext context, {
    required IconData icono,
    required String titulo,
    required String subtitulo,
    required Widget destino,
  }) {
    return Card(
      margin: const EdgeInsets.only(bottom: 12),
      child: ListTile(
        contentPadding: const EdgeInsets.symmetric(horizontal: 16, vertical: 10),
        leading: CircleAvatar(
          backgroundColor: _colorFondoOscuro,
          foregroundColor: _colorAcento,
          child: Icon(icono),
        ),
        title: Text(titulo, style: const TextStyle(fontWeight: FontWeight.bold, fontSize: 16)),
        subtitle: Text(subtitulo),
        trailing: const Icon(Icons.chevron_right),
        onTap: () => Navigator.push(
          context,
          MaterialPageRoute(builder: (context) => destino),
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFFF2F4F7),
      appBar: AppBar(
        backgroundColor: _colorFondoOscuro,
        foregroundColor: Colors.white,
        title: const Text('ENTRENADOR'),
      ),
      body: ListView(
        padding: const EdgeInsets.all(16),
        children: [
          Padding(
            padding: const EdgeInsets.only(bottom: 16, left: 4),
            child: Text(
              nombreEquipo,
              style: const TextStyle(fontSize: 20, fontWeight: FontWeight.bold),
            ),
          ),
          _boton(
            context,
            icono: Icons.groups,
            titulo: 'Roster',
            subtitulo: 'Jugadores de tu equipo',
            destino: RosterScreen(equipoId: equipoId, nombreEquipo: nombreEquipo),
          ),
          _boton(
            context,
            icono: Icons.sports_baseball,
            titulo: 'Equipos y rivales',
            subtitulo: 'Crear rivales y ver sus jugadores',
            destino: const EquiposScreen(),
          ),
          _boton(
            context,
            icono: Icons.emoji_events,
            titulo: 'Record y juegos',
            subtitulo: 'Ganados, perdidos y marcadores',
            destino: const RecordJuegosScreen(),
          ),
        ],
      ),
    );
  }
}
