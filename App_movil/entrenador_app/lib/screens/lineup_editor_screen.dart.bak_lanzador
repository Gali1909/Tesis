import 'package:flutter/material.dart';

import '../models/equipo.dart';
import '../models/jugador.dart';
import '../services/database_helper.dart';
import '../services/lineups_db.dart';

const Color _fondo = Color(0xFF14171C);
const Color _superficie = Color(0xFF1E232B);
const Color _cian = Color(0xFF0ABDCF);
const Color _textoSuave = Color(0xFF9AA4B2);

const int _minPuestos = 9;
const int _maxPuestos = 12;
const List<String> _posiciones = [
  'P', 'C', '1B', '2B', '3B', 'SS', 'LF', 'CF', 'RF', 'BD',
];

class LineupEditorScreen extends StatefulWidget {
  final int? lineupId;

  const LineupEditorScreen({super.key, this.lineupId});

  @override
  State<LineupEditorScreen> createState() => _LineupEditorScreenState();
}

class _LineupEditorScreenState extends State<LineupEditorScreen> {
  final TextEditingController _nombre = TextEditingController();
  List<Jugador> _jugadores = [];
  final List<int?> _ids = List<int?>.filled(_minPuestos, null, growable: true);
  final List<String?> _pos = List<String?>.filled(_minPuestos, null, growable: true);
  bool _cargando = true;
  bool _guardando = false;

  @override
  void initState() {
    super.initState();
    _cargar();
  }

  @override
  void dispose() {
    _nombre.dispose();
    super.dispose();
  }

  Future<void> _cargar() async {
    final db = DatabaseHelper.instance;
    final equipos = await db.obtenerEquipos();
    int? propioId;
    for (final Equipo e in equipos) {
      if (e.tipo == 'propio') {
        propioId = e.equipoId;
        break;
      }
    }
    var todos = <Jugador>[];
    if (propioId != null) {
      todos = await db.obtenerJugadoresPorEquipo(propioId);
    }

    var nombre = '';
    var puestos = <Map<String, dynamic>>[];
    if (widget.lineupId != null) {
      final info = await db.obtenerLineup(widget.lineupId!);
      nombre = (info?['nombre'] as String?) ?? '';
      puestos = await db.obtenerPuestosLineup(widget.lineupId!);
    }
    if (!mounted) return;

    final validos = todos.map((j) => j.jugadorId).toSet();
    final n = puestos.length.clamp(_minPuestos, _maxPuestos).toInt();
    _ids.clear();
    _pos.clear();
    for (var i = 0; i < n; i++) {
      if (i < puestos.length && validos.contains(puestos[i]['jugador_id'])) {
        _ids.add(puestos[i]['jugador_id'] as int);
        _pos.add(puestos[i]['posicion'] as String?);
      } else {
        _ids.add(null);
        _pos.add(null);
      }
    }
    _nombre.text = nombre;
    setState(() {
      _jugadores = todos;
      _cargando = false;
    });
  }

  String _etiqueta(Jugador j) =>
      '${j.numero != null ? '#${j.numero} ' : ''}${j.nombre}';

  bool get _completo =>
      _nombre.text.trim().isNotEmpty && _ids.every((i) => i != null);

  Future<void> _guardar() async {
    if (!_completo || _guardando) return;
    setState(() => _guardando = true);
    try {
      await DatabaseHelper.instance.guardarLineup(
        lineupId: widget.lineupId,
        nombre: _nombre.text.trim(),
        puestos: [
          for (var i = 0; i < _ids.length; i++)
            {'jugador_id': _ids[i], 'posicion': _pos[i]},
        ],
      );
      if (!mounted) return;
      Navigator.pop(context, true);
    } catch (e) {
      if (!mounted) return;
      setState(() => _guardando = false);
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text('No se pudo guardar el lineup: $e')),
      );
    }
  }

  Widget _fila(int i) {
    final usados = <int>{
      for (var k = 0; k < _ids.length; k++)
        if (k != i && _ids[k] != null) _ids[k]!,
    };
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 2),
      child: Row(
        children: [
          SizedBox(
            width: 28,
            child: Text(
              '${i + 1}',
              style: const TextStyle(
                color: _cian,
                fontWeight: FontWeight.bold,
                fontSize: 16,
              ),
            ),
          ),
          Expanded(
            child: DropdownButton<int?>(
              isExpanded: true,
              value: _ids[i],
              hint: const Text('Bateador', style: TextStyle(color: _textoSuave)),
              dropdownColor: _superficie,
              style: const TextStyle(color: Colors.white, fontSize: 15),
              items: [
                for (final j in _jugadores)
                  if (!usados.contains(j.jugadorId))
                    DropdownMenuItem<int?>(
                      value: j.jugadorId,
                      child: Text(_etiqueta(j), overflow: TextOverflow.ellipsis),
                    ),
              ],
              onChanged: (v) => setState(() => _ids[i] = v),
            ),
          ),
          const SizedBox(width: 8),
          SizedBox(
            width: 76,
            child: DropdownButton<String?>(
              isExpanded: true,
              value: _pos[i],
              hint: const Text('Pos', style: TextStyle(color: _textoSuave)),
              dropdownColor: _superficie,
              style: const TextStyle(color: Colors.white, fontSize: 15),
              items: [
                const DropdownMenuItem<String?>(value: null, child: Text('-')),
                for (final p in _posiciones)
                  DropdownMenuItem<String?>(value: p, child: Text(p)),
              ],
              onChanged: (v) => setState(() => _pos[i] = v),
            ),
          ),
        ],
      ),
    );
  }

  Widget _cuerpo() {
    return ListView(
      padding: const EdgeInsets.all(16),
      children: [
        Container(
          padding: const EdgeInsets.all(16),
          decoration: BoxDecoration(
            color: _superficie,
            borderRadius: BorderRadius.circular(16),
          ),
          child: TextField(
            controller: _nombre,
            onChanged: (_) => setState(() {}),
            style: const TextStyle(color: Colors.white),
            decoration: const InputDecoration(
              labelText: 'Nombre del lineup',
              labelStyle: TextStyle(color: _textoSuave),
              hintText: 'Ej. Titular vs derechos',
              hintStyle: TextStyle(color: _textoSuave),
            ),
          ),
        ),
        const SizedBox(height: 12),
        Container(
          padding: const EdgeInsets.all(16),
          decoration: BoxDecoration(
            color: _superficie,
            borderRadius: BorderRadius.circular(16),
          ),
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              const Text(
                'ORDEN AL BATE',
                style: TextStyle(color: _textoSuave, fontSize: 12, letterSpacing: 2),
              ),
              const SizedBox(height: 4),
              for (var i = 0; i < _ids.length; i++) _fila(i),
              const SizedBox(height: 8),
              Row(
                children: [
                  TextButton.icon(
                    onPressed: _ids.length >= _maxPuestos
                        ? null
                        : () => setState(() {
                              _ids.add(null);
                              _pos.add(null);
                            }),
                    icon: const Icon(Icons.add),
                    label: const Text('PUESTO'),
                  ),
                  TextButton.icon(
                    onPressed: _ids.length <= _minPuestos
                        ? null
                        : () => setState(() {
                              _ids.removeLast();
                              _pos.removeLast();
                            }),
                    icon: const Icon(Icons.remove),
                    label: const Text('PUESTO'),
                  ),
                ],
              ),
            ],
          ),
        ),
        if (_jugadores.length < _minPuestos)
          const Padding(
            padding: EdgeInsets.only(top: 10),
            child: Text(
              'Tu equipo tiene menos jugadores que puestos en el lineup. Agrega los que falten en Jugadores.',
              style: TextStyle(color: _textoSuave, fontSize: 12),
            ),
          ),
        const SizedBox(height: 20),
        ElevatedButton.icon(
          onPressed: (_completo && !_guardando) ? _guardar : null,
          icon: const Icon(Icons.save),
          label: const Text(
            'GUARDAR LINEUP',
            style: TextStyle(fontWeight: FontWeight.bold),
          ),
          style: ElevatedButton.styleFrom(
            backgroundColor: _cian,
            foregroundColor: Colors.black,
            disabledBackgroundColor: const Color(0xFF2A303A),
            minimumSize: const Size.fromHeight(56),
            shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(14)),
          ),
        ),
      ],
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: _fondo,
      appBar: AppBar(
        backgroundColor: _fondo,
        foregroundColor: Colors.white,
        title: Text(widget.lineupId == null ? 'NUEVO LINEUP' : 'EDITAR LINEUP'),
      ),
      body: _cargando
          ? const Center(child: CircularProgressIndicator())
          : _cuerpo(),
    );
  }
}