import 'lineups_db.dart';
import 'juego_lineup_db.dart';
import 'juego_vivo_db.dart';
import 'marcador_db.dart';
import 'dart:io';
import 'package:sqflite/sqflite.dart';
import 'package:path/path.dart';
import '../models/equipo.dart';
import '../models/jugador.dart';
import '../models/jugador_posicion.dart';
import '../models/lanzador_rol.dart';
import '../models/lanzador_perfil.dart';
import '../models/bateador_perfil.dart';
import '../models/lanzador_tipo_picheo.dart';
import '../models/bateador_vulnerabilidad.dart';
import '../models/lanzador_perfil_historico.dart';
import '../models/bateo_evento.dart';
import 'package:uuid/uuid.dart';

class DatabaseHelper {
  static final DatabaseHelper instance = DatabaseHelper._init();
  static Database? _database;

  DatabaseHelper._init();
  static final Uuid _generadorUuid = Uuid();
  String _nuevoUuid() => _generadorUuid.v4();

  Future<Database> get database async {
    if (_database != null) return _database!;
    _database = await _initDB('entrenador.db');
    return _database!;
  }

  Future<Database> _initDB(String fileName) async {
    final dbPath = await getDatabasesPath();
    final path = join(dbPath, fileName);
    return await openDatabase(
      path,
      version: 8,
      onConfigure: _configurarDB,
      onCreate: _crearBD,
      onUpgrade: _upgradeDB,
      onOpen: _alAbrir,
    );
  }

  Future<void> _configurarDB(Database db) async {
    await db.execute('PRAGMA foreign_keys = ON');
  }

  Future _createDB(Database db, int version) async {
    await db.execute('''
      CREATE TABLE equipo (
        equipo_id INTEGER PRIMARY KEY AUTOINCREMENT,
        nombre TEXT NOT NULL,
        tipo TEXT NOT NULL CHECK (tipo IN ('propio', 'rival'))
      )
    ''');

    await db.execute('''
      CREATE TABLE jugador (
        jugador_id INTEGER PRIMARY KEY AUTOINCREMENT,
        equipo_id INTEGER NOT NULL,
        nombre TEXT NOT NULL,
        rol TEXT NOT NULL CHECK (rol IN ('lanzador', 'bateador')),
        mano_bateo TEXT CHECK (mano_bateo IN ('derecha', 'izquierda', 'ambos')),
        mano_lanzamiento TEXT CHECK (mano_lanzamiento IN ('zurdo', 'derecho')),
        numero INTEGER,
        foto TEXT,
        FOREIGN KEY (equipo_id) REFERENCES equipo (equipo_id)
      )
    ''');

    await db.execute('''
      CREATE TABLE jugador_posicion (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        jugador_id INTEGER NOT NULL,
        posicion TEXT NOT NULL CHECK (posicion IN ('P', 'C', '1B', '2B', '3B', 'SS', 'LF', 'CF', 'RF')),
        FOREIGN KEY (jugador_id) REFERENCES jugador (jugador_id)
      )
    ''');

    await db.execute('''
      CREATE TABLE lanzador_rol (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        lanzador_id INTEGER NOT NULL,
        rol_lanzador TEXT NOT NULL CHECK (rol_lanzador IN ('abridor', 'relevista', 'cerrador')),
        FOREIGN KEY (lanzador_id) REFERENCES jugador (jugador_id)
      )
    ''');

    await db.execute('''
      CREATE TABLE tipo_lanzamiento (
        tipo_lanzamiento_id INTEGER PRIMARY KEY AUTOINCREMENT,
        nombre TEXT NOT NULL UNIQUE
      )
    ''');

    await db.execute('''
      CREATE TABLE lanzador_perfil (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        lanzador_id INTEGER NOT NULL,
        temporada INTEGER NOT NULL,
        juegos_ganados INTEGER DEFAULT 0,
        juegos_perdidos INTEGER DEFAULT 0,
        aperturas INTEGER DEFAULT 0,
        salvados INTEGER DEFAULT 0,
        juegos_lanzados INTEGER DEFAULT 0,
        innings_lanzados REAL DEFAULT 0,
        ponches INTEGER DEFAULT 0,
        bases_por_bolas INTEGER DEFAULT 0,
        hits_permitidos INTEGER DEFAULT 0,
        carreras_limpias INTEGER DEFAULT 0,
        FOREIGN KEY (lanzador_id) REFERENCES jugador (jugador_id),
        UNIQUE (lanzador_id, temporada)
      )
    ''');

    await db.execute('''
      CREATE TABLE lanzador_perfil_historico (
        lanzador_id INTEGER PRIMARY KEY,
        juegos_ganados INTEGER DEFAULT 0,
        juegos_perdidos INTEGER DEFAULT 0,
        aperturas INTEGER DEFAULT 0,
        salvados INTEGER DEFAULT 0,
        juegos_lanzados INTEGER DEFAULT 0,
        innings_lanzados REAL DEFAULT 0,
        ponches INTEGER DEFAULT 0,
        bases_por_bolas INTEGER DEFAULT 0,
        hits_permitidos INTEGER DEFAULT 0,
        carreras_limpias INTEGER DEFAULT 0,
        FOREIGN KEY (lanzador_id) REFERENCES jugador (jugador_id)
      )
    ''');

    await db.execute('''
      CREATE TABLE lanzador_tipo_picheo (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        lanzador_id INTEGER NOT NULL,
        tipo_lanzamiento_id INTEGER NOT NULL,
        frecuencia REAL,
        velocidad_promedio REAL,
        velocidad_max REAL,
        FOREIGN KEY (lanzador_id) REFERENCES jugador (jugador_id),
        FOREIGN KEY (tipo_lanzamiento_id) REFERENCES tipo_lanzamiento (tipo_lanzamiento_id)
      )
    ''');

    await db.execute('''
      CREATE TABLE bateador_perfil (
        bateador_id INTEGER PRIMARY KEY,
        promedio_bateo REAL,
        carreras_impulsadas INTEGER DEFAULT 0,
        carreras_anotadas INTEGER DEFAULT 0,
        home_runs INTEGER DEFAULT 0,
        dobles INTEGER DEFAULT 0,
        triples INTEGER DEFAULT 0,
        hits INTEGER DEFAULT 0,
        turnos_al_bate INTEGER DEFAULT 0,
        bases_por_bolas INTEGER DEFAULT 0,
        golpe_por_lanzador INTEGER DEFAULT 0,
        elevado_sacrificio INTEGER DEFAULT 0,
        bases_robadas INTEGER DEFAULT 0,
        FOREIGN KEY (bateador_id) REFERENCES jugador (jugador_id)
      )
    ''');

    await db.execute('''
      CREATE TABLE bateador_vulnerabilidad (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        bateador_id INTEGER NOT NULL,
        tipo_lanzamiento_id INTEGER NOT NULL,
        nivel_efectividad_contra REAL,
        origen TEXT NOT NULL CHECK (origen IN ('manual', 'calculado')),
        FOREIGN KEY (bateador_id) REFERENCES jugador (jugador_id),
        FOREIGN KEY (tipo_lanzamiento_id) REFERENCES tipo_lanzamiento (tipo_lanzamiento_id)
      )
    ''');

    await db.execute('''
      CREATE TABLE bateo_evento (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        bateador_id INTEGER NOT NULL,
        juego_id INTEGER,
        tipo_lanzamiento_id INTEGER NOT NULL,
        resultado TEXT NOT NULL CHECK (resultado IN ('sencillo','doble','triple','home_run','out','ponche','boleto','golpe_por_lanzador')),
        fecha TEXT NOT NULL,
        FOREIGN KEY (bateador_id) REFERENCES jugador (jugador_id),
        FOREIGN KEY (juego_id) REFERENCES juego (juego_id),
        FOREIGN KEY (tipo_lanzamiento_id) REFERENCES tipo_lanzamiento (tipo_lanzamiento_id)
      )
    ''');

    await db.execute('''
      CREATE TABLE juego (
        juego_id INTEGER PRIMARY KEY AUTOINCREMENT,
        fecha TEXT NOT NULL,
        equipo_rival_id INTEGER,
        carreras_propias INTEGER,
        carreras_rival INTEGER,
        FOREIGN KEY (equipo_rival_id) REFERENCES equipo (equipo_id)
      )
    ''');

    await crearTablasMarcador(db);
    await crearTablasJuegoVivo(db);
    await crearTablasLineup(db);
    await crearTablasLineupsGuardados(db);

    await db.execute('''
      CREATE TABLE estadistica_juego_lanzador (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        juego_id INTEGER NOT NULL,
        lanzador_id INTEGER NOT NULL,
        innings_lanzados_juego REAL,
        picheos_lanzados INTEGER,
        carreras_permitidas INTEGER,
        ponches INTEGER,
        bases_por_bolas INTEGER,
        hits_permitidos INTEGER,
        FOREIGN KEY (juego_id) REFERENCES juego (juego_id),
        FOREIGN KEY (lanzador_id) REFERENCES jugador (jugador_id)
      )
    ''');

    await db.execute('''
      CREATE TABLE estadistica_juego_bateador (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        juego_id INTEGER NOT NULL,
        bateador_id INTEGER NOT NULL,
        turnos_al_bate INTEGER,
        hits_juego INTEGER,
        carreras_impulsadas_juego INTEGER,
        carreras_anotadas_juego INTEGER,
        home_runs_juego INTEGER,
        dobles_juego INTEGER,
        triples_juego INTEGER,
        ponches_juego INTEGER,
        bases_por_bolas_juego INTEGER,
        FOREIGN KEY (juego_id) REFERENCES juego (juego_id),
        FOREIGN KEY (bateador_id) REFERENCES jugador (jugador_id)
      )
    ''');

    await db.execute('''
      CREATE TABLE jugada_estrategica (
        jugada_id INTEGER PRIMARY KEY AUTOINCREMENT,
        nombre TEXT NOT NULL,
        descripcion TEXT,
        audio_path TEXT
      )
    ''');

    await db.execute('''
      CREATE TABLE sincronizacion (
        sync_id INTEGER PRIMARY KEY AUTOINCREMENT,
        fecha TEXT NOT NULL,
        origen TEXT NOT NULL,
        estado TEXT NOT NULL CHECK (estado IN ('exitosa', 'fallida', 'parcial')),
        registros_importados INTEGER DEFAULT 0,
        detalle TEXT
      )
    ''');
  }

  static const Map<String, String> _tablasConUuid = {
    'equipo': 'equipo_id',
    'jugador': 'jugador_id',
    'juego': 'juego_id',
    'bateo_evento': 'id',
    'bateador_vulnerabilidad': 'id',
  };

  Future<void> _crearBD(Database db, int version) async {
    await _createDB(db, version);
    await _agregarUuid(db);
  }

  /// Agrega carreras_limpias a estadistica_juego_lanzador si todavia no existe.
  Future<void> _agregarCarrerasLimpias(Database db) async {
    final columnas = await db.rawQuery('PRAGMA table_info(estadistica_juego_lanzador)');
    final existe = columnas.any((c) => c['name'] == 'carreras_limpias');
    if (!existe) {
      await db.execute(
        'ALTER TABLE estadistica_juego_lanzador ADD COLUMN carreras_limpias INTEGER DEFAULT 0',
      );
    }
  }

  Future<void> _alAbrir(Database db) async {
    await _migrarTemporadaBateador(db);
    await _agregarCarrerasLimpias(db);
    await _agregarUuid(db);
    await _rellenarUuidFaltantes(db);
    await _prepararMembresias(db);
    await _migrarEquipoOpcional(db);
  }

  /// 1.4c: jugador.equipo_id y jugador_equipo.equipo_id pasan a ser opcionales
  /// para que un jugador libre (o el historial de un equipo borrado) no dependa
  /// de un equipo. Se reconstruyen las tablas con su misma definicion.
  Future<bool> _columnaObligatoria(
    Database db,
    String tabla,
    String columna,
  ) async {
    final info = await db.rawQuery('PRAGMA table_info($tabla)');
    for (final c in info) {
      if (c['name'] == columna) return c['notnull'] == 1;
    }
    return false;
  }

  Future<void> _reconstruirEquipoOpcional(
    DatabaseExecutor ex,
    String tabla,
  ) async {
    final filas = await ex.rawQuery(
      "SELECT sql FROM sqlite_master WHERE type = 'table' AND name = ?",
      [tabla],
    );
    final sqlViejo = filas.first['sql'] as String;
    final sinNotNull = sqlViejo.replaceFirst(
      RegExp(r'equipo_id\s+INTEGER\s+NOT\s+NULL', caseSensitive: false),
      'equipo_id INTEGER',
    );
    if (sinNotNull == sqlViejo) {
      throw Exception('No se pudo adaptar la definicion de $tabla');
    }
    final sqlNuevo = sinNotNull.replaceFirst(
      RegExp(
        'CREATE TABLE\\s+(IF NOT EXISTS\\s+)?["`\\[]?$tabla["`\\]]?(?=\\s*\\()',
        caseSensitive: false,
      ),
      'CREATE TABLE ${tabla}_nueva',
    );
    if (!sqlNuevo.contains('${tabla}_nueva')) {
      throw Exception('No se pudo renombrar la definicion de $tabla');
    }

    final indices = await ex.rawQuery(
      "SELECT sql FROM sqlite_master WHERE type = 'index' AND tbl_name = ? AND sql IS NOT NULL",
      [tabla],
    );
    final secuencia = await ex.rawQuery(
      'SELECT seq FROM sqlite_sequence WHERE name = ?',
      [tabla],
    );

    await ex.execute(sqlNuevo);
    await ex.execute('INSERT INTO ${tabla}_nueva SELECT * FROM $tabla');
    await ex.execute('DROP TABLE $tabla');
    await ex.execute('ALTER TABLE ${tabla}_nueva RENAME TO $tabla');
    for (final i in indices) {
      await ex.execute(i['sql'] as String);
    }
    if (secuencia.isNotEmpty) {
      await ex.rawUpdate(
        'UPDATE sqlite_sequence SET seq = ? WHERE name = ?',
        [secuencia.first['seq'], tabla],
      );
    }
  }

  Future<void> _migrarEquipoOpcional(Database db) async {
    final jugadorObligatorio =
        await _columnaObligatoria(db, 'jugador', 'equipo_id');
    final membresiaObligatoria =
        await _columnaObligatoria(db, 'jugador_equipo', 'equipo_id');
    final columnasMembresia =
        await db.rawQuery('PRAGMA table_info(jugador_equipo)');
    final tieneNombre =
        columnasMembresia.any((c) => c['name'] == 'nombre_equipo');
    if (!jugadorObligatorio && !membresiaObligatoria && tieneNombre) return;

    try {
      final copia = File('${db.path}.bak_equipo_opcional');
      if (!await copia.exists()) {
        await File(db.path).copy(copia.path);
      }

      if (!tieneNombre) {
        await db.execute(
          'ALTER TABLE jugador_equipo ADD COLUMN nombre_equipo TEXT',
        );
      }

      if (jugadorObligatorio || membresiaObligatoria) {
        await db.execute('PRAGMA foreign_keys = OFF');
        await db.transaction((txn) async {
          if (jugadorObligatorio) {
            await _reconstruirEquipoOpcional(txn, 'jugador');
          }
          if (membresiaObligatoria) {
            await _reconstruirEquipoOpcional(txn, 'jugador_equipo');
          }
          if (jugadorObligatorio) {
            // Los jugadores sin pertenencia vigente quedan sin equipo.
            await txn.execute('''
              UPDATE jugador SET equipo_id = NULL
              WHERE jugador_id NOT IN (
                SELECT jugador_id FROM jugador_equipo WHERE fecha_fin IS NULL
              )
            ''');
          }
          final problemas = await txn.rawQuery('PRAGMA foreign_key_check');
          if (problemas.isNotEmpty) {
            throw Exception(
              'foreign_key_check: ${problemas.length} violaciones, '
              'primeras: ${problemas.take(5).toList()}',
            );
          }
        });
      }
    } catch (e) {
      // ignore: avoid_print
      print('1.4c: migracion cancelada, se conserva el esquema anterior: $e');
    } finally {
      await db.execute('PRAGMA foreign_keys = ON');
    }
  }
  /// Historial de pertenencia de jugadores a equipos (fase 1.4).
  /// fecha_fin NULL = pertenencia vigente. motivo_salida: 'cambiado' o 'libre'.
  Future<void> _prepararMembresias(Database db) async {
    await db.execute('''
      CREATE TABLE IF NOT EXISTS jugador_equipo (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        uuid TEXT,
        jugador_id INTEGER NOT NULL,
        equipo_id INTEGER NOT NULL,
        fecha_inicio TEXT,
        fecha_fin TEXT,
        motivo_salida TEXT CHECK (motivo_salida IN ('cambiado', 'libre')),
        FOREIGN KEY (jugador_id) REFERENCES jugador (jugador_id),
        FOREIGN KEY (equipo_id) REFERENCES equipo (equipo_id)
      )
    ''');
    await db.execute(
      'CREATE UNIQUE INDEX IF NOT EXISTS idx_jugador_equipo_uuid ON jugador_equipo (uuid)',
    );

    // Jugadores que todavia no tienen ninguna pertenencia: se les crea la vigente.
    final sinPertenencia = await db.rawQuery('''
      SELECT jugador_id, equipo_id FROM jugador
      WHERE jugador_id NOT IN (SELECT jugador_id FROM jugador_equipo)
    ''');
    for (final j in sinPertenencia) {
      await db.insert('jugador_equipo', {
        'uuid': _nuevoUuid(),
        'jugador_id': j['jugador_id'],
        'equipo_id': j['equipo_id'],
      });
    }
    // ignore: avoid_print
    print('Membresias: ${sinPertenencia.length} jugadores migrados');
  }

  /// Pasa al jugador a [equipoId]. Si tenia pertenencia vigente la cierra como
  /// 'cambiado'; si estaba libre, simplemente lo ficha.
  Future<void> asignarJugadorAEquipo({
    required int jugadorId,
    required int equipoId,
  }) async {
    final db = await database;
    final hoy = DateTime.now().toIso8601String().substring(0, 10);
    await db.transaction((txn) async {
      await txn.update(
        'jugador_equipo',
        {'fecha_fin': hoy, 'motivo_salida': 'cambiado'},
        where: 'jugador_id = ? AND fecha_fin IS NULL',
        whereArgs: [jugadorId],
      );
      await txn.insert('jugador_equipo', {
        'uuid': _nuevoUuid(),
        'jugador_id': jugadorId,
        'equipo_id': equipoId,
        'fecha_inicio': hoy,
      });
      await txn.update(
        'jugador',
        {'equipo_id': equipoId},
        where: 'jugador_id = ?',
        whereArgs: [jugadorId],
      );
    });
  }

  /// Cierra la pertenencia vigente como 'libre'. El jugador y sus
  /// estadisticas se conservan.
  Future<void> dejarJugadorLibre(int jugadorId) async {
    final db = await database;
    final hoy = DateTime.now().toIso8601String().substring(0, 10);
    await db.transaction((txn) async {
      await txn.update(
        'jugador_equipo',
        {'fecha_fin': hoy, 'motivo_salida': 'libre'},
        where: 'jugador_id = ? AND fecha_fin IS NULL',
        whereArgs: [jugadorId],
      );
      await txn.update(
        'jugador',
        {'equipo_id': null},
        where: 'jugador_id = ?',
        whereArgs: [jugadorId],
      );
    });
  }

  /// Jugadores sin pertenencia vigente.
  Future<List<Jugador>> obtenerJugadoresLibres() async {
    final db = await database;
    final resultado = await db.rawQuery('''
      SELECT j.* FROM jugador j
      WHERE NOT EXISTS (
        SELECT 1 FROM jugador_equipo m
        WHERE m.jugador_id = j.jugador_id AND m.fecha_fin IS NULL
      )
      ORDER BY j.nombre
    ''');
    return resultado.map((mapa) => Jugador.fromMap(mapa)).toList();
  }
  /// Equipos por los que ha pasado el jugador (la pertenencia vigente primero).
  Future<List<Map<String, dynamic>>> historialEquiposJugador(int jugadorId) async {
    final db = await database;
    return db.rawQuery('''
      SELECT m.id, m.equipo_id,
             COALESCE(e.nombre, m.nombre_equipo, 'Equipo eliminado') AS equipo_nombre,
             m.fecha_inicio, m.fecha_fin, m.motivo_salida
      FROM jugador_equipo m
      LEFT JOIN equipo e ON e.equipo_id = m.equipo_id
      WHERE m.jugador_id = ?
      ORDER BY (m.fecha_fin IS NULL) DESC, m.fecha_fin DESC, m.id DESC
    ''', [jugadorId]);
  }
  /// Da uuid a las filas que quedaron sin uno (por ejemplo juegos creados
  /// antes de que se generara el uuid al insertarlos).
  Future<void> _rellenarUuidFaltantes(Database db) async {
    for (final entrada in _tablasConUuid.entries) {
      final tabla = entrada.key;
      final clave = entrada.value;
      final columnas = await db.rawQuery('PRAGMA table_info($tabla)');
      if (!columnas.any((c) => c['name'] == 'uuid')) continue;
      final filas = await db.query(
        tabla,
        columns: [clave],
        where: 'uuid IS NULL',
      );
      for (final fila in filas) {
        await db.update(
          tabla,
          {'uuid': _nuevoUuid()},
          where: '$clave = ?',
          whereArgs: [fila[clave]],
        );
      }
    }
  }
  Future<void> _migrarTemporadaBateador(Database db) async {
    final columnas = await db.rawQuery('PRAGMA table_info(bateador_perfil)');
    if (columnas.any((c) => c['name'] == 'temporada')) return;
    final temporadaActual = DateTime.now().year;
    await db.transaction((txn) async {
      await txn.execute('''
        CREATE TABLE bateador_perfil_nueva (
          id INTEGER PRIMARY KEY AUTOINCREMENT,
          bateador_id INTEGER NOT NULL,
          temporada INTEGER NOT NULL,
          promedio_bateo REAL,
          carreras_impulsadas INTEGER DEFAULT 0,
          carreras_anotadas INTEGER DEFAULT 0,
          home_runs INTEGER DEFAULT 0,
          dobles INTEGER DEFAULT 0,
          triples INTEGER DEFAULT 0,
          hits INTEGER DEFAULT 0,
          turnos_al_bate INTEGER DEFAULT 0,
          bases_por_bolas INTEGER DEFAULT 0,
          golpe_por_lanzador INTEGER DEFAULT 0,
          elevado_sacrificio INTEGER DEFAULT 0,
          bases_robadas INTEGER DEFAULT 0,
          FOREIGN KEY (bateador_id) REFERENCES jugador (jugador_id),
          UNIQUE (bateador_id, temporada)
        )
      ''');
      await txn.execute(
        '''
        INSERT INTO bateador_perfil_nueva (
          bateador_id, temporada, promedio_bateo, carreras_impulsadas,
          carreras_anotadas, home_runs, dobles, triples, hits, turnos_al_bate,
          bases_por_bolas, golpe_por_lanzador, elevado_sacrificio, bases_robadas
        )
        SELECT
          bateador_id, ?, promedio_bateo, carreras_impulsadas,
          carreras_anotadas, home_runs, dobles, triples, hits, turnos_al_bate,
          bases_por_bolas, golpe_por_lanzador, elevado_sacrificio, bases_robadas
        FROM bateador_perfil
        ''',
        [temporadaActual],
      );
      await txn.execute('DROP TABLE bateador_perfil');
      await txn.execute('ALTER TABLE bateador_perfil_nueva RENAME TO bateador_perfil');
    });
  }

  Future<void> _agregarUuid(Database db) async {
    for (final entrada in _tablasConUuid.entries) {
      final tabla = entrada.key;
      final clave = entrada.value;
      final columnas = await db.rawQuery('PRAGMA table_info($tabla)');
      if (columnas.any((c) => c['name'] == 'uuid')) continue;
      // 1. Agregar la columna
      await db.execute('ALTER TABLE $tabla ADD COLUMN uuid TEXT');
      // 2. Dar un uuid a las filas que ya existen
      final filas = await db.query(tabla, columns: [clave]);
      for (final fila in filas) {
        await db.update(
          tabla,
          {'uuid': _nuevoUuid()},
          where: '$clave = ?',
          whereArgs: [fila[clave]],
        );
      }
      // 3. Evitar que dos filas tengan el mismo uuid
      await db.execute(
        'CREATE UNIQUE INDEX idx_${tabla}_uuid ON $tabla (uuid)',
      );
    }
  }

  Future<void> _upgradeDB(Database db, int oldVersion, int newVersion) async {
    if (oldVersion < 2) {
      await db.execute(
        'ALTER TABLE bateador_perfil ADD COLUMN turnos_al_bate INTEGER DEFAULT 0',
      );
      await db.execute(
        'ALTER TABLE bateador_perfil ADD COLUMN bases_por_bolas INTEGER DEFAULT 0',
      );
      await db.execute(
        'ALTER TABLE bateador_perfil ADD COLUMN golpe_por_lanzador INTEGER DEFAULT 0',
      );
      await db.execute(
        'ALTER TABLE bateador_perfil ADD COLUMN elevado_sacrificio INTEGER DEFAULT 0',
      );
      await db.execute(
        'ALTER TABLE bateador_perfil ADD COLUMN bases_robadas INTEGER DEFAULT 0',
      );
    }
    if (oldVersion < 3) {
      await db.execute('''
        CREATE TABLE IF NOT EXISTS bateo_evento (
          id INTEGER PRIMARY KEY AUTOINCREMENT,
          bateador_id INTEGER NOT NULL,
          juego_id INTEGER,
          tipo_lanzamiento_id INTEGER NOT NULL,
          resultado TEXT NOT NULL CHECK (resultado IN ('sencillo','doble','triple','home_run','out','ponche','boleto','golpe_por_lanzador')),
          fecha TEXT NOT NULL,
          FOREIGN KEY (bateador_id) REFERENCES jugador (jugador_id),
          FOREIGN KEY (juego_id) REFERENCES juego (juego_id),
          FOREIGN KEY (tipo_lanzamiento_id) REFERENCES tipo_lanzamiento (tipo_lanzamiento_id)
        )
      ''');
      }
    if (oldVersion < 4) {
      await _agregarUuid(db);
    }
    if (oldVersion < 5) {
      await crearTablasMarcador(db);
    }
    if (oldVersion < 6) {
      await crearTablasJuegoVivo(db);
    }
    if (oldVersion < 7) {
      await crearTablasLineup(db);
    }
    if (oldVersion < 8) {
      await crearTablasLineupsGuardados(db);
    }
  }

