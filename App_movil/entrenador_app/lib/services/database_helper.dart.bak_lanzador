      SELECT e.*, j.fecha, j.carreras_propias, j.carreras_rival, q.nombre AS rival_nombre
      FROM estadistica_juego_bateador e
      JOIN juego j ON j.juego_id = e.juego_id
      LEFT JOIN equipo q ON q.equipo_id = j.equipo_rival_id
      WHERE e.bateador_id = ?
      ORDER BY j.fecha DESC, j.juego_id DESC
    ''', [bateadorId]);
  }

