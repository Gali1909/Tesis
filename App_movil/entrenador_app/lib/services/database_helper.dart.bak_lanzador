  Future<int> borrarEquipo(int equipoId) async {
    final db = await instance.database;
    final jugadores = await db.rawQuery(
      '''
      SELECT m.jugador_id AS jugador_id FROM jugador_equipo m
      WHERE m.equipo_id = ? AND m.fecha_fin IS NULL
      ''',
      [equipoId],
    );
    for (final j in jugadores) {
      await borrarJugador(j['jugador_id'] as int);
    }
    // Se conserva el historial: la fila queda sin equipo pero con su nombre.
    await db.rawUpdate(
      'UPDATE jugador_equipo SET nombre_equipo = '
      '(SELECT nombre FROM equipo WHERE equipo_id = ?), equipo_id = NULL '
      'WHERE equipo_id = ?',
      [equipoId, equipoId],
    );
    // Los jugadores libres que apuntaban a este equipo se conservan.
    await db.update(
      'jugador',
      {'equipo_id': null},
      where: 'equipo_id = ?',
      whereArgs: [equipoId],
    );
    await db.update(
      'juego',
      {'equipo_rival_id': null},
      where: 'equipo_rival_id = ?',
      whereArgs: [equipoId],
    );
    return await db.delete(
      'equipo',
      where: 'equipo_id = ?',
      whereArgs: [equipoId],
    );
  }

  Future<int> crearJugador(Jugador jugador) async {
    final db = await instance.database;
    return await db.transaction((txn) async {
      final id = await txn.insert('jugador', {
        ...jugador.toMap(),
        'uuid': _nuevoUuid(),
      });
      await txn.insert('jugador_equipo', {
        'uuid': _nuevoUuid(),
        'jugador_id': id,
        'equipo_id': jugador.equipoId,
        'fecha_inicio': DateTime.now().toIso8601String().substring(0, 10),
      });
      return id;
    });
  }

