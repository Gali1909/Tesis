  /// Registra el juego de un bateador. Reutiliza el juego si ya existe
  /// uno con la misma fecha y rival.
  Future<int> registrarJuegoBateador({
    required int bateadorId,
    required String fecha, // 'yyyy-MM-dd'
    int? equipoRivalId,
    int? carrerasPropias,
    int? carrerasRival,
    required int turnos,
    required int hits,
    required int dobles,
    required int triples,
    required int homeRuns,
    required int impulsadas,
    required int anotadas,
    required int ponches,
    required int basesPorBolas,
  }) async {
    final db = await database;
    return await db.transaction((txn) async {
      final int juegoId = await _obtenerOCrearJuego(txn, fecha, equipoRivalId, carrerasPropias, carrerasRival);

      final repetido = await txn.query(
        'estadistica_juego_bateador',
        where: 'juego_id = ? AND bateador_id = ?',
        whereArgs: [juegoId, bateadorId],
        limit: 1,
      );
      if (repetido.isNotEmpty) {
        throw StateError('Este bateador ya tiene un juego registrado en esa fecha.');
      }

      return await txn.insert('estadistica_juego_bateador', {
        'juego_id': juegoId,
        'bateador_id': bateadorId,
        'turnos_al_bate': turnos,
        'hits_juego': hits,
        'dobles_juego': dobles,
        'triples_juego': triples,
        'home_runs_juego': homeRuns,
        'carreras_impulsadas_juego': impulsadas,
        'carreras_anotadas_juego': anotadas,
        'ponches_juego': ponches,
        'bases_por_bolas_juego': basesPorBolas,
      });
    });
  }

  /// Suma los últimos [n] juegos registrados del bateador.
  Future<Map<String, dynamic>> ultimosJuegosBateador(int bateadorId, int n) async {
    final db = await database;
    final r = await db.rawQuery('''
      SELECT COUNT(*) AS juegos,
             COALESCE(SUM(turnos_al_bate), 0) AS ab,
             COALESCE(SUM(hits_juego), 0) AS h,
             COALESCE(SUM(dobles_juego), 0) AS dobles,
             COALESCE(SUM(triples_juego), 0) AS triples,
             COALESCE(SUM(home_runs_juego), 0) AS hr,
             COALESCE(SUM(carreras_impulsadas_juego), 0) AS ci,
             COALESCE(SUM(carreras_anotadas_juego), 0) AS ca,
             COALESCE(SUM(ponches_juego), 0) AS k,
             COALESCE(SUM(bases_por_bolas_juego), 0) AS bb
      FROM (
        SELECT e.* FROM estadistica_juego_bateador e
        JOIN juego j ON j.juego_id = e.juego_id
        WHERE e.bateador_id = ?
        ORDER BY j.fecha DESC, j.juego_id DESC
        LIMIT ?
      )
    ''', [bateadorId, n]);

    final m = r.first;
    final ab = m['ab'] as int;
    final h = m['h'] as int;
    final totalBases = h + (m['dobles'] as int) + 2 * (m['triples'] as int) + 3 * (m['hr'] as int);
    return {
      ...m,
      'avg': ab == 0 ? 0.0 : h / ab,
      'slg': ab == 0 ? 0.0 : totalBases / ab,
    };
  }

  /// Historial para el perfil (más reciente primero).
  Future<List<Map<String, dynamic>>> historialJuegosBateador(int bateadorId) async {
    final db = await database;
