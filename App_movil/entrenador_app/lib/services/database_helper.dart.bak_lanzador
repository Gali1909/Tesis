      '''
      SELECT bateador_vulnerabilidad.id,
             bateador_vulnerabilidad.tipo_lanzamiento_id,
             bateador_vulnerabilidad.nivel_efectividad_contra,
             bateador_vulnerabilidad.origen,
             tipo_lanzamiento.nombre
      FROM bateador_vulnerabilidad
      JOIN tipo_lanzamiento
        ON bateador_vulnerabilidad.tipo_lanzamiento_id = tipo_lanzamiento.tipo_lanzamiento_id
      WHERE bateador_vulnerabilidad.bateador_id = ?
