  static const List<String> tiposLanzamientoPredeterminados = [
    'Four-Seam Fastball',
    'Two-Seam Fastball',
    'Sinker',
    'Cutter',
    'Split-Finger Fastball',
    'Curveball',
    'Slider',
    'Sweeper',
    'Changeup',
    'Circle Change',
    'Splitter',
    'Forkball',
    'Knuckleball',
    'Screwball',
  ];

  Future<List<Map<String, dynamic>>> obtenerCatalogoTiposLanzamiento() async {
    final db = await instance.database;

    for (final nombre in tiposLanzamientoPredeterminados) {
      await db.insert('tipo_lanzamiento', {
        'nombre': nombre,
      }, conflictAlgorithm: ConflictAlgorithm.ignore);
    }

    final resultado = await db.query('tipo_lanzamiento');
    final lista = List<Map<String, dynamic>>.from(resultado);

    int posicion(String nombre) {
      final i = tiposLanzamientoPredeterminados.indexOf(nombre);
      return i == -1 ? tiposLanzamientoPredeterminados.length : i;
    }

    lista.sort((a, b) {
      final pa = posicion(a['nombre'] as String);
      final pb = posicion(b['nombre'] as String);
      if (pa != pb) return pa.compareTo(pb);
      return (a['nombre'] as String).compareTo(b['nombre'] as String);
    });

    return lista;
  }

  Future<int> obtenerOCrearTipoLanzamiento(String nombre) async {
    final db = await instance.database;
    final nombreLimpio = nombre.trim();
    final existente = await db.query(
