  // ---------- Rival, resultado y record del equipo ----------

  Future<List<Equipo>> obtenerEquiposRivales() async {
    final db = await database;
    final r = await db.query('equipo', where: "tipo = 'rival'", orderBy: 'nombre');
    return r.map((m) => Equipo.fromMap(m)).toList();
  }

  /// Busca el juego de esa fecha (y rival) o lo crea. Completa rival y
  /// marcador si llegan datos nuevos.
  Future<int> _obtenerOCrearJuego(
    DatabaseExecutor txn,
    String fecha,
    int? rivalId,
    int? carrerasPropias,
    int? carrerasRival,
  ) async {
    final delDia = await txn.query(
      'juego',
      where: 'fecha = ?',
      whereArgs: [fecha],
      orderBy: 'juego_id',
    );

    Map<String, Object?>? elegido;
    if (rivalId == null) {
      if (delDia.isNotEmpty) elegido = delDia.first;
    } else {
      for (final j in delDia) {
        if (j['equipo_rival_id'] == rivalId) {
          elegido = j;
          break;
        }
      }
      if (elegido == null) {
        for (final j in delDia) {
          if (j['equipo_rival_id'] == null) {
            elegido = j;
            break;
          }
        }
      }
    }

    if (elegido == null) {
      return await txn.insert('juego', {
        'uuid': _nuevoUuid(),
        'fecha': fecha,
        'equipo_rival_id': rivalId,
        'carreras_propias': carrerasPropias,
        'carreras_rival': carrerasRival,
      });
    }

    final juegoId = elegido['juego_id'] as int;
    final cambios = <String, Object?>{};
    if (rivalId != null && elegido['equipo_rival_id'] == null) {
      cambios['equipo_rival_id'] = rivalId;
    }
    if (carrerasPropias != null && carrerasRival != null) {
      cambios['carreras_propias'] = carrerasPropias;
      cambios['carreras_rival'] = carrerasRival;
    }
    if (cambios.isNotEmpty) {
      await txn.update('juego', cambios, where: 'juego_id = ?', whereArgs: [juegoId]);
    }
    return juegoId;
  }

  /// Record del equipo (solo juegos con marcador). [anio] null = todos.
  Future<Map<String, int>> recordEquipo({int? anio}) async {
    final db = await database;
    final filtroAnio = anio == null ? '' : "AND strftime('%Y', fecha) = ?";
    final r = await db.rawQuery('''
      SELECT
        COALESCE(SUM(CASE WHEN carreras_propias > carreras_rival THEN 1 ELSE 0 END), 0) AS g,
        COALESCE(SUM(CASE WHEN carreras_propias < carreras_rival THEN 1 ELSE 0 END), 0) AS p,
        COALESCE(SUM(CASE WHEN carreras_propias = carreras_rival THEN 1 ELSE 0 END), 0) AS e
      FROM juego
      WHERE carreras_propias IS NOT NULL AND carreras_rival IS NOT NULL
      $filtroAnio
    ''', anio == null ? [] : [anio.toString()]);
    final m = r.first;
    return {
      'g': (m['g'] as num).toInt(),
      'p': (m['p'] as num).toInt(),
      'e': (m['e'] as num).toInt(),
    };
  }
  // ---------- Totales de temporada: base manual + juegos registrados ----------

  /// Temporadas con base cargada a mano o con juegos registrados.
  Future<List<int>> obtenerTemporadasBateadorTotal(int bateadorId) async {
    final base = await obtenerTemporadasBateador(bateadorId);
    final db = await database;
    final r = await db.rawQuery('''
      SELECT DISTINCT CAST(strftime('%Y', j.fecha) AS INTEGER) AS anio
      FROM estadistica_juego_bateador e
      JOIN juego j ON j.juego_id = e.juego_id
      WHERE e.bateador_id = ?
    ''', [bateadorId]);
    final todas = <int>{...base, ...r.map((m) => (m['anio'] as num).toInt())}.toList()
      ..sort((a, b) => b.compareTo(a));
    return todas;
  }

  /// Perfil de la temporada = base manual + suma de los juegos de ese anio.
  /// Bases robadas, golpeados y elevados de sacrificio salen solo de la base.
  Future<BateadorPerfil?> obtenerBateadorPerfilTotal(int bateadorId, {int? temporada}) async {
    final base = await obtenerBateadorPerfil(bateadorId, temporada: temporada);
    final anio = temporada ?? base?.temporada;
    if (anio == null) return base;

    final db = await database;
    final r = await db.rawQuery('''
      SELECT COUNT(*) AS juegos,
             COALESCE(SUM(e.turnos_al_bate), 0) AS ab,
             COALESCE(SUM(e.hits_juego), 0) AS h,
             COALESCE(SUM(e.dobles_juego), 0) AS dobles,
             COALESCE(SUM(e.triples_juego), 0) AS triples,
             COALESCE(SUM(e.home_runs_juego), 0) AS hr,
             COALESCE(SUM(e.carreras_impulsadas_juego), 0) AS ci,
             COALESCE(SUM(e.carreras_anotadas_juego), 0) AS ca,
             COALESCE(SUM(e.bases_por_bolas_juego), 0) AS bb
      FROM estadistica_juego_bateador e
      JOIN juego j ON j.juego_id = e.juego_id
      WHERE e.bateador_id = ? AND strftime('%Y', j.fecha) = ?
    ''', [bateadorId, anio.toString()]);

    final m = r.first;
    if ((m['juegos'] as num).toInt() == 0) return base;
    int n(String k) => (m[k] as num).toInt();

    return BateadorPerfil(
      bateadorId: bateadorId,
      temporada: anio,
      carrerasImpulsadas: (base?.carrerasImpulsadas ?? 0) + n('ci'),
      carrerasAnotadas: (base?.carrerasAnotadas ?? 0) + n('ca'),
      homeRuns: (base?.homeRuns ?? 0) + n('hr'),
      dobles: (base?.dobles ?? 0) + n('dobles'),
      triples: (base?.triples ?? 0) + n('triples'),
      hits: (base?.hits ?? 0) + n('h'),
      turnosAlBate: (base?.turnosAlBate ?? 0) + n('ab'),
      basesPorBolas: (base?.basesPorBolas ?? 0) + n('bb'),
      golpePorLanzador: base?.golpePorLanzador ?? 0,
      elevadoSacrificio: base?.elevadoSacrificio ?? 0,
      basesRobadas: base?.basesRobadas ?? 0,
    );
  }
  // ---------- Totales de lanzador: base manual + salidas registradas ----------

  /// Convierte innings guardados a outs. 6.1 y 6.2 son notacion de beisbol
  /// (19 y 20 outs); otros decimales (6.33, 6.67) se toman como tercios reales.
  int _outsDeInnings(double v) {
    final entero = v.floor();
    final fraccion = (v - entero) * 10;
    final d = fraccion.round();
    if ((fraccion - d).abs() < 0.05 && d >= 0 && d <= 2) {
      return entero * 3 + d;
    }
    return (v * 3).round();
  }

  Future<List<int>> obtenerTemporadasLanzadorTotal(int lanzadorId) async {
    final base = await obtenerTemporadasLanzador(lanzadorId);
    final db = await database;
    final r = await db.rawQuery('''
      SELECT DISTINCT CAST(strftime('%Y', j.fecha) AS INTEGER) AS anio
      FROM estadistica_juego_lanzador e
      JOIN juego j ON j.juego_id = e.juego_id
      WHERE e.lanzador_id = ?
    ''', [lanzadorId]);
    final todas = <int>{...base, ...r.map((m) => (m['anio'] as num).toInt())}.toList()
      ..sort((a, b) => b.compareTo(a));
    return todas;
  }

  /// Perfil de la temporada = base manual + salidas de ese anio.
  /// Ganados, perdidos, aperturas y salvados salen solo de la base.
  Future<LanzadorPerfil?> obtenerLanzadorPerfilTotal(int lanzadorId, int temporada) async {
    final base = await obtenerLanzadorPerfil(lanzadorId, temporada);
    final db = await database;
    final r = await db.rawQuery('''
      SELECT COUNT(*) AS salidas,
             COALESCE(SUM(CAST(ROUND(e.innings_lanzados_juego * 3) AS INTEGER)), 0) AS outs,
             COALESCE(SUM(e.hits_permitidos), 0) AS h,
             COALESCE(SUM(e.carreras_limpias), 0) AS cl,
             COALESCE(SUM(e.ponches), 0) AS k,
             COALESCE(SUM(e.bases_por_bolas), 0) AS bb
      FROM estadistica_juego_lanzador e
      JOIN juego j ON j.juego_id = e.juego_id
      WHERE e.lanzador_id = ? AND strftime('%Y', j.fecha) = ?
    ''', [lanzadorId, temporada.toString()]);

    final m = r.first;
    int n(String k) => (m[k] as num).toInt();
    final salidas = n('salidas');
    if (base == null && salidas == 0) return null;

    final outsBase = base == null ? 0 : _outsDeInnings(base.inningsLanzados);

    return LanzadorPerfil(
      id: base?.id,
      lanzadorId: lanzadorId,
      temporada: temporada,
      juegosGanados: base?.juegosGanados ?? 0,
      juegosPerdidos: base?.juegosPerdidos ?? 0,
      aperturas: base?.aperturas ?? 0,
      salvados: base?.salvados ?? 0,
      juegosLanzados: (base?.juegosLanzados ?? 0) + salidas,
      inningsLanzados: (outsBase + n('outs')) / 3.0,
      ponches: (base?.ponches ?? 0) + n('k'),
      basesPorBolas: (base?.basesPorBolas ?? 0) + n('bb'),
      hitsPermitidos: (base?.hitsPermitidos ?? 0) + n('h'),
      carrerasLimpias: (base?.carrerasLimpias ?? 0) + n('cl'),
    );
  }
  // ---------- Pantalla de record y juegos ----------

  Future<List<int>> obtenerAniosJuegos() async {
    final db = await database;
    final r = await db.rawQuery('''
      SELECT DISTINCT CAST(strftime('%Y', fecha) AS INTEGER) AS anio
      FROM juego
      ORDER BY anio DESC
    ''');
    return r.map((m) => (m['anio'] as num).toInt()).toList();
  }

  /// Juegos con rival y marcador. [anio] null = todos.
  Future<List<Map<String, dynamic>>> obtenerJuegosEquipo({int? anio}) async {
    final db = await database;
    final filtro = anio == null ? '' : "WHERE strftime('%Y', j.fecha) = ?";
    return db.rawQuery('''
      SELECT j.juego_id, j.fecha, j.equipo_rival_id, j.carreras_propias,
             j.carreras_rival, q.nombre AS rival_nombre,
             (SELECT COUNT(*) FROM juego_entrada e WHERE e.juego_id = j.juego_id) AS num_entradas
      FROM juego j
      LEFT JOIN equipo q ON q.equipo_id = j.equipo_rival_id
      $filtro
      ORDER BY j.fecha DESC, j.juego_id DESC
    ''', anio == null ? [] : [anio.toString()]);
  }

  Future<void> actualizarResultadoJuego(
    int juegoId, {
    required int? rivalId,
    required int? propias,
    required int? rival,
  }) async {
    final db = await database;
    await db.update(
      'juego',
      {
        'equipo_rival_id': rivalId,
        'carreras_propias': propias,
        'carreras_rival': rival,
      },
      where: 'juego_id = ?',
      whereArgs: [juegoId],
    );
  }}
