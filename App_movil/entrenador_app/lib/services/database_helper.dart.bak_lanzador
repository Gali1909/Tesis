      where: 'nombre = ?',
      whereArgs: [nombreLimpio],
    );
    if (existente.isNotEmpty) {
      return existente.first['tipo_lanzamiento_id'] as int;
    }
    return await db.insert('tipo_lanzamiento', {'nombre': nombreLimpio});
  }

