  Future<int> borrarJugador(int jugadorId) async {
    final db = await instance.database;
    return await db.transaction((txn) async {
      // tabla -> columna que apunta al jugador
      const tablasHijas = {
        'jugador_posicion': 'jugador_id',
        'lanzador_rol': 'lanzador_id',
        'lanzador_perfil': 'lanzador_id',
        'lanzador_perfil_historico': 'lanzador_id',
        'lanzador_tipo_picheo': 'lanzador_id',
        'bateador_perfil': 'bateador_id',
        'bateador_vulnerabilidad': 'bateador_id',
        'bateo_evento': 'bateador_id',
        'estadistica_juego_lanzador': 'lanzador_id',
        'estadistica_juego_bateador': 'bateador_id',
        'jugador_equipo': 'jugador_id',
      };
      for (final entrada in tablasHijas.entries) {
        await txn.delete(
          entrada.key,
          where: '${entrada.value} = ?',
          whereArgs: [jugadorId],
        );
      }
      return await txn.delete(
        'jugador',
        where: 'jugador_id = ?',
        whereArgs: [jugadorId],
      );
    });
  }

