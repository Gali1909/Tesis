  // ---------- Salidas de lanzador (estadistica_juego_lanzador) ----------

  /// Registra una salida. [outs] = innings * 3 (6.1 innings = 19 outs).
  Future<int> registrarSalidaLanzador({
    required int lanzadorId,
    required String fecha, // 'yyyy-MM-dd'
    int? equipoRivalId,
    int? carrerasPropias,
    int? carrerasRival,
    required int outs,
    required int picheos,
    required int carrerasPermitidas,
    required int carrerasLimpias,
    required int hitsPermitidos,
    required int ponches,
    required int basesPorBolas,
  }) async {
    final db = await database;
    return await db.transaction((txn) async {
      final int juegoId = await _obtenerOCrearJuego(txn, fecha, equipoRivalId, carrerasPropias, carrerasRival);

      final repetido = await txn.query(
        'estadistica_juego_lanzador',
        where: 'juego_id = ? AND lanzador_id = ?',
        whereArgs: [juegoId, lanzadorId],
        limit: 1,
      );
      if (repetido.isNotEmpty) {
        throw StateError('Este lanzador ya tiene una salida registrada en esa fecha.');
      }

      return await txn.insert('estadistica_juego_lanzador', {
        'juego_id': juegoId,
        'lanzador_id': lanzadorId,
        'innings_lanzados_juego': outs / 3.0,
        'picheos_lanzados': picheos,
        'carreras_permitidas': carrerasPermitidas,
        'carreras_limpias': carrerasLimpias,
        'hits_permitidos': hitsPermitidos,
        'ponches': ponches,
        'bases_por_bolas': basesPorBolas,
      });
    });
  }

  /// Suma las ultimas [n] salidas registradas del lanzador.
  Future<Map<String, dynamic>> ultimasSalidasLanzador(int lanzadorId, int n) async {
    final db = await database;
    final r = await db.rawQuery('''
      SELECT COUNT(*) AS salidas,
             COALESCE(SUM(CAST(ROUND(innings_lanzados_juego * 3) AS INTEGER)), 0) AS outs,
             COALESCE(SUM(picheos_lanzados), 0) AS picheos,
             COALESCE(SUM(carreras_permitidas), 0) AS cp,
             COALESCE(SUM(carreras_limpias), 0) AS cl,
             COALESCE(SUM(hits_permitidos), 0) AS h,
             COALESCE(SUM(ponches), 0) AS k,
             COALESCE(SUM(bases_por_bolas), 0) AS bb
      FROM (
        SELECT e.* FROM estadistica_juego_lanzador e
        JOIN juego j ON j.juego_id = e.juego_id
        WHERE e.lanzador_id = ?
        ORDER BY j.fecha DESC, j.juego_id DESC
        LIMIT ?
      )
    ''', [lanzadorId, n]);

    final m = r.first;
    final outs = m['outs'] as int;
    final cl = m['cl'] as int;
    final h = m['h'] as int;
    final k = m['k'] as int;
    final bb = m['bb'] as int;
    return {
      ...m,
      'ip': '${outs ~/ 3}.${outs % 3}',
      'era': outs == 0 ? 0.0 : cl * 27 / outs,
      'whip': outs == 0 ? 0.0 : (bb + h) * 3 / outs,
      'k9': outs == 0 ? 0.0 : k * 27 / outs,
    };
  }

