  Future<int> guardarBateadorVulnerabilidad({
    int? id,
    required int bateadorId,
    required int tipoLanzamientoId,
    double? nivelEfectividadContra,
  }) async {
    final db = await instance.database;
    final datos = {
      'bateador_id': bateadorId,
      'tipo_lanzamiento_id': tipoLanzamientoId,
      'nivel_efectividad_contra': nivelEfectividadContra,
      'origen': 'manual',
    };
    int? idDestino = id;
    if (idDestino == null) {
      final repetido = await db.query(
        'bateador_vulnerabilidad',
        columns: ['id'],
        where: 'bateador_id = ? AND tipo_lanzamiento_id = ?',
        whereArgs: [bateadorId, tipoLanzamientoId],
      );
      if (repetido.isNotEmpty) idDestino = repetido.first['id'] as int;
    }
    if (idDestino != null) {
      return await db.update(
        'bateador_vulnerabilidad',
        datos,
        where: 'id = ?',
        whereArgs: [idDestino],
      );
    }
    return await db.insert('bateador_vulnerabilidad', {
      ...datos,
      'uuid': _nuevoUuid(),
    });
  }

